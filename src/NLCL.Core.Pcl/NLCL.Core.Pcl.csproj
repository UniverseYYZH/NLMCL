<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>NLCL.Core.Pcl</RootNamespace>
    <AssemblyName>NLCL.Core.Pcl</AssemblyName>
    <!-- PCL 的 C# 源码依赖隐式 using 与集合表达式，这里必须打开 -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- PCL 源码依赖的全局 using，与 PCLCS.csproj 保持一致。
         MeloongCore 提供 RegexSeek / Capitalize / GetOrDefault / FileUtils / Logger——
         这些正是 PCL 的 C# 代码所需要的，因此不再自建近似垫片。 -->
    <Using Include="Newtonsoft.Json" />
    <Using Include="Newtonsoft.Json.Linq" />
    <Using Include="System.Text.RegularExpressions" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="MeloongCore" />
    <Using Include="MeloongCore.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NLCL.Abstractions\NLCL.Abstractions.csproj" />
    <ProjectReference Include="..\..\third_party\MeloongCore\Shared\MeloongCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All" />
  </ItemGroup>

</Project>
