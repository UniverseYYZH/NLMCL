<UserControl x:Class="NLCL.App.Views.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NLCL.App"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

            <DataTemplate x:Key="DownloadVersionTemplate">
                <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="13.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="1" Background="{StaticResource PrimarySoft}"
                                CornerRadius="10" Padding="8,2" Margin="10,0">
                            <TextBlock Text="{Binding TypeLabel}" FontSize="10.5"
                                       Foreground="{StaticResource Primary}" />
                        </Border>

                        <TextBlock Grid.Column="2" Text="{Binding ReleasedAt, StringFormat=yyyy-MM-dd}"
                                   FontSize="10.5" Foreground="{StaticResource Faint}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="版本下载" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource Text}" />
            <TextBlock Text="从 Mojang 官方源下载原版；安装完可直接在「本地版本」里启动"
                       FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
        </StackPanel>

        <!-- 目录 + 操作 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,16,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="安装到" FontSize="11"
                           Foreground="{StaticResource Muted}" />
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                            CornerRadius="7" Padding="10,7">
                        <TextBlock Text="{Binding TargetDirectory}" FontSize="11.5"
                                   Foreground="{StaticResource Text}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Button Grid.Column="1" Content="⟳ 刷新列表" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Command="{Binding LoadVersionsCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" />
                    <Button Grid.Column="2" Content="↓ 安装选中版本" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Padding="16,8"
                            Command="{Binding InstallCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 加载器 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="加载器" FontSize="11"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Margin="10,0,0,0" FontSize="11.5"
                          ItemsSource="{Binding Loaders}"
                          SelectedItem="{Binding SelectedLoader}" />

                <TextBlock Grid.Column="2" Text="加载器版本" FontSize="11"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           Visibility="{Binding IsFabricSelected, Converter={StaticResource BoolToVisibility}}" />
                <Border Grid.Column="3" Background="{StaticResource Surface}" Margin="10,0,0,0"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                        CornerRadius="7" Padding="10,5"
                        Visibility="{Binding IsFabricSelected, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Text="{Binding LoaderVersion, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" FontSize="11.5"
                             Foreground="{StaticResource Text}" />
                </Border>

                <TextBlock Grid.Column="4" FontSize="10.5" Foreground="{StaticResource Faint}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="Fabric 会生成独立版本目录，并自动继承所选原版的库与资源" />
            </Grid>
        </Border>

        <!-- 版本列表：必须是可选中的（原来用 ItemsControl，点哪一行都没反应，
             实际永远装列表第一项，而第一项通常是快照） -->
        <ListBox Grid.Row="3"
                 Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}"
                 ItemsSource="{Binding Versions}"
                 SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                 ItemTemplate="{StaticResource DownloadVersionTemplate}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Ring" BorderThickness="2" BorderBrush="Transparent"
                                        CornerRadius="11" Padding="0">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush"
                                                Value="{StaticResource Primary}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush"
                                                Value="{StaticResource BorderColor}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="正在获取版本列表…" FontSize="12" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- 进度 + 状态 -->
        <StackPanel Grid.Row="4" Margin="2,12,0,0">
            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Progress}"
                         Foreground="{StaticResource Primary}" Background="{StaticResource Surface}"
                         Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" FontSize="11"
                       Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
