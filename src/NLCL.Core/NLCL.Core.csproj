<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>NLCL.Core</RootNamespace>
    <AssemblyName>NLCL.Core</AssemblyName>
    <!--
      CS8600 / CS8604：VersionPlanBuilder 遍历的是"什么都可能是 null"的版本 JSON
      （JToken.Value<string>() 全部返回可空）。这里已有逐字段的显式判空，
      但 Roslyn 在 net48 的引用程序集上（缺少 NotNullWhen 标注）无法收敛流分析。
      仅抑制这两个"可能是 null"的提示，其余可空性告警保持开启。
    -->
    <NoWarn>$(NoWarn);8600;8604</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NLCL.Abstractions\NLCL.Abstractions.csproj" />
    <!-- 哈希校验复用 MeloongCore（Apache-2.0），不自写实现 -->
    <ProjectReference Include="..\..\third_party\MeloongCore\Shared\MeloongCore.csproj" />
    <!-- 单测要直接验证清单解析等 internal 辅助方法 -->
    <InternalsVisibleTo Include="NLCL.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All" />
    <!-- net48 下 ZipArchive 在单独的转发程序集里 -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- DPAPI（ProtectedData）用于加密账号令牌 -->
    <Reference Include="System.Security" />
  </ItemGroup>
</Project>
