<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        深色主题：只覆盖 Design.xaml 里的颜色键。
        所有界面都通过 DynamicResource 取色，所以运行期换这份字典即可即时生效。
    -->
    <SolidColorBrush x:Key="Bg" Color="#101512" />
    <SolidColorBrush x:Key="Card" Color="#19211B" />
    <SolidColorBrush x:Key="Surface" Color="#202A22" />
    <SolidColorBrush x:Key="BorderColor" Color="#2C3830" />
    <SolidColorBrush x:Key="Text" Color="#E7EFE9" />
    <SolidColorBrush x:Key="Muted" Color="#A3B1A7" />
    <SolidColorBrush x:Key="Faint" Color="#7A887E" />
    <SolidColorBrush x:Key="Primary" Color="#57B383" />
    <SolidColorBrush x:Key="PrimarySoft" Color="#223529" />
    <SolidColorBrush x:Key="SidebarBg" Color="#0C1310" />
    <SolidColorBrush x:Key="SidebarActive" Color="#1B3226" />
    <SolidColorBrush x:Key="SidebarHover" Color="#16241B" />
    <SolidColorBrush x:Key="SidebarText" Color="#EFF7F1" />
    <SolidColorBrush x:Key="SidebarMuted" Color="#90A396" />
    <SolidColorBrush x:Key="SidebarFaint" Color="#55635A" />
    <SolidColorBrush x:Key="Amber" Color="#E0A33A" />
    <SolidColorBrush x:Key="AmberBg" Color="#2E2517" />
    <SolidColorBrush x:Key="AmberBorder" Color="#4A3B22" />
    <SolidColorBrush x:Key="Snapshot" Color="#E5B25B" />
    <SolidColorBrush x:Key="SnapshotBg" Color="#2C2418" />
    <SolidColorBrush x:Key="Old" Color="#9BA79E" />
    <SolidColorBrush x:Key="OldBg" Color="#232B25" />
    <SolidColorBrush x:Key="Error" Color="#F2726A" />
</ResourceDictionary>
