<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        高对比度主题：深灰底、浅色文字、柔和强边框、黄色主色。
        不使用纯黑 + 纯白边框，避免刺眼和页面间割裂。
    -->
    <SolidColorBrush x:Key="Bg" Color="#101317" />
    <SolidColorBrush x:Key="Card" Color="#181D23" />
    <SolidColorBrush x:Key="Surface" Color="#20262E" />
    <SolidColorBrush x:Key="BorderColor" Color="#AEB8C2" />
    <SolidColorBrush x:Key="Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Muted" Color="#D7DEE5" />
    <SolidColorBrush x:Key="Faint" Color="#AEB8C2" />
    <SolidColorBrush x:Key="Primary" Color="#FFD84D" />
    <SolidColorBrush x:Key="PrimarySoft" Color="#3B3210" />
    <SolidColorBrush x:Key="SidebarBg" Color="#0B0E12" />
    <SolidColorBrush x:Key="SidebarActive" Color="#332B00" />
    <SolidColorBrush x:Key="SidebarHover" Color="#1A2027" />
    <SolidColorBrush x:Key="SidebarLogoBg" Color="#20262E" />
    <SolidColorBrush x:Key="SidebarAccountBg" Color="#181D23" />
    <SolidColorBrush x:Key="SidebarText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarMuted" Color="#D7DEE5" />
    <SolidColorBrush x:Key="SidebarFaint" Color="#AEB8C2" />
    <SolidColorBrush x:Key="Amber" Color="#FFD84D" />
    <SolidColorBrush x:Key="AmberBg" Color="#332B00" />
    <SolidColorBrush x:Key="AmberBorder" Color="#AEB8C2" />
    <SolidColorBrush x:Key="Snapshot" Color="#FFD84D" />
    <SolidColorBrush x:Key="SnapshotBg" Color="#332B00" />
    <SolidColorBrush x:Key="Old" Color="#D7DEE5" />
    <SolidColorBrush x:Key="OldBg" Color="#20262E" />
    <SolidColorBrush x:Key="Error" Color="#FF8A80" />
</ResourceDictionary>
