<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 颜色令牌：来源 legacy/ui_theme.py，唯一真源 ===== -->
    <Color x:Key="BgColor">#F4F6F1</Color>
    <Color x:Key="SidebarBgColor">#173B2B</Color>
    <Color x:Key="SidebarActiveColor">#285A41</Color>
    <Color x:Key="PrimaryColor">#2F6B4F</Color>
    <Color x:Key="AmberColor">#966000</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface" Color="#F8FAF7" />
    <SolidColorBrush x:Key="BorderColor" Color="#E4E9E2" />
    <SolidColorBrush x:Key="Text" Color="#17231B" />
    <SolidColorBrush x:Key="Muted" Color="#68776D" />
    <SolidColorBrush x:Key="Faint" Color="#96A29A" />
    <SolidColorBrush x:Key="Primary" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimarySoft" Color="#E8F1EA" />
    <SolidColorBrush x:Key="SidebarBg" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="SidebarActive" Color="{StaticResource SidebarActiveColor}" />
    <SolidColorBrush x:Key="SidebarHover" Color="#1E3A2A" />
    <SolidColorBrush x:Key="SidebarText" Color="#F4FAF6" />
    <SolidColorBrush x:Key="SidebarMuted" Color="#9DB5A6" />
    <SolidColorBrush x:Key="SidebarFaint" Color="#5D6B61" />

    <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="AmberBg" Color="#FFF6E2" />
    <SolidColorBrush x:Key="AmberBorder" Color="#EFDDB5" />
    <SolidColorBrush x:Key="Snapshot" Color="#A85F00" />
    <SolidColorBrush x:Key="SnapshotBg" Color="#FFF1DA" />
    <SolidColorBrush x:Key="Old" Color="#5D6B61" />
    <SolidColorBrush x:Key="OldBg" Color="#EFF2EE" />
    <SolidColorBrush x:Key="Error" Color="#B42318" />

    <FontFamily x:Key="UiFont">Microsoft YaHei UI</FontFamily>

    <!-- ===== 卡片 ===== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- ===== 主按钮 ===== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Primary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="18" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 次级按钮（描边） ===== -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 侧栏导航项：视图模型驱动选中，不依赖 ListBox 选择态 ===== -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarMuted}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarActive}" />
                            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 小徽章（计数 / 类型） ===== -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource PrimarySoft}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== 侧栏分组标题 ===== -->
    <Style x:Key="NavGroupCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarFaint}" />
        <Setter Property="Margin" Value="20,14,20,4" />
    </Style>

    <!-- ===== 整行可点（版本卡片） ===== -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>