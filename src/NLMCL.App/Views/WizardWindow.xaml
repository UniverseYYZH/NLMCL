<Window x:Class="NLMCL.App.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NLMCL.App"
        Title="NLMCL · 首次使用"
        Width="620" Height="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource UiFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="第一次使用，先做三件事" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource Text}" />
            <TextBlock Text="① 选游戏目录   ② 检查 Java   ③ 登录（可跳过）"
                       FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- 第 1 步：目录 -->
        <StackPanel Grid.Row="1" Margin="0,20,0,0"
                    Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Minecraft 游戏目录（.minecraft）" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}" />
            <TextBlock Text="通常在这里：%APPDATA%\.minecraft；自定义整合包可以另选目录。"
                       FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,10" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="6" Padding="10,7">
                    <TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" FontSize="11.5"
                             Foreground="{DynamicResource Text}" />
                </Border>

                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0" Padding="12,7"
                        Command="{Binding PickDirectoryCommand}" />
            </Grid>
        </StackPanel>

        <!-- 第 2 步：Java -->
        <StackPanel Grid.Row="1" Margin="0,20,0,0"
                    Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Java 检测" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}" />
            <TextBlock Text="没有 Java 也能继续：启动时会自动下载（需要联网）。"
                       FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,10" />

            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" Height="170">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Javas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" Margin="0,2"
                                           Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Button Content="重新检测" Style="{StaticResource GhostButton}" Padding="12,7"
                    Margin="0,10,0,0" HorizontalAlignment="Left"
                    Command="{Binding DetectJavaCommand}" />
        </StackPanel>

        <!-- 第 3 步：登录 -->
        <StackPanel Grid.Row="1" Margin="0,20,0,0"
                    Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="登录（可选）" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}" />
            <TextBlock Text="填一个名字就能以离线模式进游戏；外置登录 / 微软登录可以在启动后从侧栏账号卡进入。"
                       FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,10" />

            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="6" Padding="10,7" Width="260" HorizontalAlignment="Left">
                <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" FontSize="12"
                         Foreground="{DynamicResource Text}" />
            </Border>
        </StackPanel>

        <!-- 状态 + 按钮 -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                       Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="上一步" Style="{StaticResource GhostButton}"
                        Padding="14,7" Command="{Binding BackCommand}"
                        IsEnabled="{Binding CanGoBack}" />

                <Button Grid.Column="1" Content="跳过引导" Style="{StaticResource GhostButton}"
                        Padding="14,7" Margin="0,0,10,0" HorizontalAlignment="Right"
                        ToolTip="跳过也能用，之后在设置里可以重新触发"
                        Command="{Binding SkipCommand}" />

                <Button Grid.Column="2" Content="下一步" Style="{StaticResource PrimaryButton}"
                        Padding="18,7" Command="{Binding NextCommand}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource InverseBoolToVisibility}}" />

                <Button Grid.Column="2" Content="完成" Style="{StaticResource PrimaryButton}"
                        Padding="18,7" Command="{Binding FinishCommand}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
