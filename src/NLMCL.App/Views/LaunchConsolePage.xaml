<UserControl x:Class="NLMCL.App.Views.LaunchConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NLMCL.App"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- 一条日志：时间/标签列 + 正文 -->
            <DataTemplate x:Key="LogLineTemplate">
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                            VerticalAlignment="Top" MinWidth="72"
                            Background="#1B2A24"
                            Visibility="{Binding ShowTag, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding TagLabel}" FontSize="9.5"
                                   Foreground="{Binding Color}" TextAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding Text}"
                               FontFamily="Consolas, Cascadia Mono" FontSize="11.5"
                               Foreground="{Binding Color}" TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="启动与日志" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource Text}" />
                <TextBlock Text="捕获游戏进程输出，按 Java 不兼容 / 模组冲突 / 资源失败自动着色"
                           FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="▶  启动" Style="{StaticResource PrimaryButton}" Padding="16,8"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                <Button Content="■  停止" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding IsRunning}" />
                <Button Content="■  全部停止" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        ToolTip="多开时一次停掉所有游戏"
                        Command="{Binding StopAllCommand}"
                        IsEnabled="{Binding IsRunning}" />
                <Button Content="清空" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding ClearCommand}" />
                <Button Content="崩溃分析" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        ToolTip="读取崩溃报告 / latest.log，指出可疑原因"
                        Command="{Binding AnalyzeCrashCommand}" />
            </StackPanel>
        </Grid>

        <!-- 版本输入 + 状态 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,16,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="版本目录名" FontSize="11"
                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{DynamicResource Surface}" Margin="10,0"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="7" Padding="10,6">
                    <TextBox Text="{Binding VersionId, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" FontSize="11.5"
                             Foreground="{DynamicResource Text}" />
                </Border>

        <!-- 多开会话栏：点一下切换查看哪个游戏的日志 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,10"
                Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="正在运行的游戏" FontSize="10.5"
                           Foreground="{DynamicResource Muted}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding BarSessions}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8" Padding="10,6"
                                    HorizontalContentAlignment="Left"
                                    ToolTip="{Binding Subtitle}"
                                    Command="{Binding DataContext.SelectSessionCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="10.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="9"
                                               Foreground="{DynamicResource Faint}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11"
                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                           Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />

                <Border Grid.Column="3" Style="{StaticResource Chip}"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <TextBlock Style="{StaticResource ChipText}" Foreground="{DynamicResource Muted}">
                        <Run Text="异常行 " /><Run Text="{Binding ErrorCount, Mode=OneWay}" />
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- 崩溃分析结果：可关闭；内容超高时在卡片内滚动，不再把日志区挤没 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,0,0,10"
                Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="崩溃分析" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                    <Button Content="关闭" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right" Padding="10,2" FontSize="10.5"
                            Command="{Binding CloseAnalysisCommand}" />
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="180" Margin="0,6,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding AnalysisText}" FontSize="11"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                               FontFamily="Consolas" />
                </ScrollViewer>
            </Grid>
        </Border>
        <!-- 日志区 -->
        <Border Grid.Row="3" Background="#101A16" CornerRadius="10" Padding="12,10">
            <Grid>
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lines}"
                                  ItemTemplate="{StaticResource LogLineTemplate}" />
                </ScrollViewer>

                <TextBlock Text="点击「启动」后，游戏的输出会出现在这里"
                           FontSize="11.5" Foreground="#4E6357"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasLines, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
