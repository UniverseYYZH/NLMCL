<UserControl x:Class="NLMCL.App.Views.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NLMCL.App"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />

            <!-- 点整行即打开安装弹层（仿 PCL 的选择版本 → 选加载器 → 安装） -->
            <DataTemplate x:Key="DownloadVersionTemplate">
                <Button Style="{StaticResource RowButton}"
                        Command="{Binding DataContext.OpenInstallCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="13.5"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                       VerticalAlignment="Center" />

                            <Border Grid.Column="1" Background="{DynamicResource PrimarySoft}"
                                    CornerRadius="10" Padding="8,2" Margin="10,0">
                                <TextBlock Text="{Binding TypeLabel}" FontSize="10.5"
                                           Foreground="{DynamicResource Primary}" />
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource PrimarySoft}"
                                    CornerRadius="10" Padding="8,2" Margin="0,0,8,0"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="已安装" FontSize="10" Foreground="{DynamicResource Primary}" />
                            </Border>

                            <TextBlock Grid.Column="3" Text="{Binding ReleasedAt, StringFormat=yyyy-MM-dd}"
                                       FontSize="10.5" Foreground="{DynamicResource Faint}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Button>
            </DataTemplate>

            <!-- 筛选按钮：选中项高亮 -->
            <Style x:Key="FilterChip" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="版本下载" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource Text}" />
            <TextBlock Text="从 Mojang 官方源下载原版；点一个版本即可选择加载器并安装"
                       FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" />
        </StackPanel>

        <!-- 目录 + 刷新 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,16,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="安装到" FontSize="11"
                           Foreground="{DynamicResource Muted}" />
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="7" Padding="10,7">
                        <TextBlock Text="{Binding TargetDirectory}" FontSize="11.5"
                                   Foreground="{DynamicResource Text}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Button Grid.Column="1" Content="⟳ 刷新列表" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Command="{Binding LoadVersionsCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 搜索 + 类型筛选 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="7" Padding="10,7" Margin="0,0,10,0">
                <Grid>
                    <TextBlock Text="搜索版本（例如 1.21 或 24w）" FontSize="11.5"
                               Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" FontSize="11.5"
                             Foreground="{DynamicResource Text}" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="全部"
                        Command="{Binding SelectFilterCommand}" CommandParameter="全部">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedFilter}" Value="全部">
                                    <Setter Property="Background" Value="{DynamicResource PrimarySoft}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="正式版"
                        Command="{Binding SelectFilterCommand}" CommandParameter="正式版">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedFilter}" Value="正式版">
                                    <Setter Property="Background" Value="{DynamicResource PrimarySoft}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="快照"
                        Command="{Binding SelectFilterCommand}" CommandParameter="快照">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedFilter}" Value="快照">
                                    <Setter Property="Background" Value="{DynamicResource PrimarySoft}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 版本列表：点整行打开安装弹层 -->
        <ListBox Grid.Row="3"
                 Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}"
                 ItemsSource="{Binding FilteredVersions}"
                 ItemTemplate="{StaticResource DownloadVersionTemplate}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="正在获取版本列表…" FontSize="12" Foreground="{DynamicResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- 状态 -->
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" FontSize="11"
                   Foreground="{DynamicResource Muted}" Margin="2,10,0,0" />

        <!-- 安装弹层：选加载器 → 安装 -->
        <Grid Grid.RowSpan="5" Panel.ZIndex="100" Background="#66000000"
              Visibility="{Binding IsInstallPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Card}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Padding="18,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="安装版本" FontSize="11" Foreground="{DynamicResource Faint}"
                                   VerticalAlignment="Center" />
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource GhostButton}" Padding="9,1" FontSize="11"
                                Command="{Binding CloseInstallCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding InstallTargetLabel}" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource Text}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="加载器" FontSize="10.5" Foreground="{DynamicResource Muted}" />
                            <ComboBox ItemsSource="{Binding Loaders}"
                                      SelectedItem="{Binding SelectedLoader}"
                                      Margin="0,5,0,0" Padding="8,5" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="加载器版本" FontSize="10.5"
                                       Foreground="{DynamicResource Muted}"
                                       Visibility="{Binding IsFabricSelected, Converter={StaticResource BoolToVisibility}}" />
                            <ComboBox ItemsSource="{Binding LoaderVersions}"
                                      SelectedItem="{Binding LoaderVersion}"
                                      Margin="0,5,0,0" Padding="8,5"
                                      Visibility="{Binding IsFabricSelected, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Fabric 会生成独立版本目录，并自动继承所选原版的库与资源。"
                               FontSize="9.5" Foreground="{DynamicResource Faint}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />

                    <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                 Foreground="{DynamicResource Primary}" Background="{DynamicResource Surface}"
                                 Margin="0,14,0,0"
                                 Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                               Foreground="{DynamicResource Muted}" Margin="0,10,0,0"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="取消" Style="{StaticResource GhostButton}"
                                Padding="14,7" Command="{Binding CloseInstallCommand}" />
                        <Button Content="开始安装" Style="{StaticResource PrimaryButton}"
                                Padding="18,8" Margin="8,0,0,0"
                                Command="{Binding InstallCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
