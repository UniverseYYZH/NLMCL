<UserControl x:Class="NLMCL.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NLMCL.App"
             DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <local:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!-- 游戏目录 -->
        <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="游戏目录" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" />
                <TextBlock Text="作用域：全局 · 生效：立即" FontSize="9.5"
                           Foreground="{DynamicResource Faint}" Margin="0,4,0,0" />

                <Border Background="{DynamicResource Surface}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="6" Padding="8,5">
                    <TextBlock Text="{Binding CurrentGameDirectory}" FontSize="10.5"
                               Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="更换目录" Style="{StaticResource GhostButton}" Padding="12,6"
                            Command="{Binding PickGameDirectoryCommand}" />
                    <Button Content="打开目录" Style="{StaticResource GhostButton}" Padding="12,6" Margin="8,0,0,0"
                            Command="{Binding OpenGameDirectoryCommand}" />
                </StackPanel>

                <TextBlock Text="换了目录会重新扫描版本列表；存档、mods 都跟着目录走。"
                           FontSize="9.5" Foreground="{DynamicResource Faint}"
                           Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 默认 JVM 参数 -->
        <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="默认 JVM 参数" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" />
                <TextBlock Text="作用域：全局（所有实例）· 生效：下次启动" FontSize="9.5"
                           Foreground="{DynamicResource Faint}" Margin="0,4,0,0" />

                <Border Background="{DynamicResource Surface}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="6" Padding="8,5">
                    <Grid>
                        <TextBlock Text="例如 -XX:+UseG1GC -XX:MaxGCPauseMillis=50"
                                   FontSize="10.5" Foreground="{DynamicResource Faint}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding DefaultJvmArgs, Converter={StaticResource EmptyToVisibility}}" />
                        <TextBox Text="{Binding DefaultJvmArgs, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="10.5"
                                 Foreground="{DynamicResource Text}" />
                    </Grid>
                </Border>

                <TextBlock Text="会拼在实例自己的「额外参数」之前；两处都填就都生效（顺序：全局 → 实例）。"
                           FontSize="9.5" Foreground="{DynamicResource Faint}"
                           Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 日志与诊断 -->
        <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="日志与诊断" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" />
                <TextBlock Text="遇到问题先打诊断包，发给开发者能直接定位" FontSize="9.5"
                           Foreground="{DynamicResource Faint}" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="打开日志目录" Style="{StaticResource GhostButton}" Padding="12,6"
                            Command="{Binding OpenLogsFolderCommand}" />
                    <Button Content="生成诊断包" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="8,0,0,0"
                            Command="{Binding CreateDiagnosticBundleCommand}" />
                </StackPanel>

                <TextBlock FontSize="9.5" Foreground="{DynamicResource Faint}"
                           Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="16">
                    <Run Text="诊断包只含 logs 与 last-launch.txt，不含账号令牌。" />
                    <LineBreak />
                    <Run Text="位置：%APPDATA%\NLMCL\diagnostics\；生成后会自动打开所在文件夹。" />
                </TextBlock>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
