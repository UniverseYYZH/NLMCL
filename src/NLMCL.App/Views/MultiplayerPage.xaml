<UserControl x:Class="NLMCL.App.Views.MultiplayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NLMCL.App"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <local:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="联机房间" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource Text}" />
            <TextBlock Text="同一局域网内直接连：一方在游戏里「对局域网开放」，另一方填地址加入"
                       FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" />

            <!-- 常用服务器快捷入口 -->
            <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="常用服务器" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="点一下直接用当前选中的版本启动并进服"
                               FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,3,0,10" />

                    <ItemsControl ItemsSource="{Binding Servers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                                    <Button Style="{StaticResource GhostButton}"
                                            Padding="14,8" Content="{Binding Name}"
                                            ToolTip="{Binding DisplayAddress}"
                                            Command="{Binding DataContext.QuickJoinCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource GhostButton}" Content="×"
                                            Width="26" Padding="0" Margin="2,0,0,0" ToolTip="移除"
                                            Command="{Binding DataContext.RemoveServerCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="6" Padding="8,5">
                            <TextBox Text="{Binding NewServerName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="11.5"
                                     Foreground="{DynamicResource Text}"
                                     ToolTip="名称（可留空）" />
                        </Border>

                        <Border Grid.Column="1" Margin="8,0,0,0" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="6" Padding="8,5">
                            <TextBox Text="{Binding NewServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="11.5"
                                     Foreground="{DynamicResource Text}"
                                     ToolTip="地址，例如 play.example.com 或 1.2.3.4:25565" />
                        </Border>

                        <Button Grid.Column="2" Content="添加" Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0" Padding="14,6"
                                Command="{Binding AddServerCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 我的房间 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="① 我开房" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" />
                <TextBlock Text="游戏里按 Esc →「对局域网开放」，把聊天栏显示的端口填进来"
                           FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="端口" FontSize="10.5"
                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{DynamicResource Surface}" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="6" Padding="8,5">
                        <TextBox Text="{Binding MyPort, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="11.5"
                                 Foreground="{DynamicResource Text}" />
                    </Border>

                    <Button Grid.Column="2" Content="生成地址" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Command="{Binding RefreshMyAddressCommand}" />

                    <Border Grid.Column="3" Background="{DynamicResource PrimarySoft}" Margin="12,0,0,0"
                            CornerRadius="6" Padding="12,6">
                        <TextBlock Text="{Binding MyAddress}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource Primary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Border>

                    <Button Grid.Column="4" Content="复制" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Padding="14,6"
                            Command="{Binding CopyMyAddressCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 加入房间 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="② 我加入" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" />
                <TextBlock Text="填对方给你的地址（形如 10.21.3.9:54321），会先探测端口再启动"
                           FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="6" Padding="10,6">
                        <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="11.5"
                                 Foreground="{DynamicResource Text}" />
                    </Border>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="▶  连接并启动" Style="{StaticResource PrimaryButton}"
                                Padding="16,8"
                                Command="{Binding ConnectToLanCommand}"
                                IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}" />
                        <Button Content="跳过探测启动" Style="{StaticResource GhostButton}"
                                Margin="6,0,0,0" Padding="12,8" ToolTip="端口探测失败时仍强制启动"
                                Command="{Binding ForceConnectCommand}"
                                IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}" />
                        <Button Content="诊断" Style="{StaticResource GhostButton}"
                                Margin="6,0,0,0" Padding="12,8" ToolTip="检查 DNS / 端口 / Minecraft 状态"
                                Command="{Binding DiagnoseCommand}" />
                    </WrapPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 说明 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,12,0,0"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="诊断结果" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" />
                <TextBlock Text="{Binding DiagnosticsText}" FontSize="10.5" Margin="0,6,0,0"
                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                           FontFamily="Consolas" />
            </StackPanel>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,12,0,0"
                VerticalAlignment="Top">
            <StackPanel>

                <TextBlock Text="校园网提示" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" />
                <TextBlock FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"
                           TextWrapping="Wrap" LineHeight="18">
                    <Run Text="· 同一个 WiFi / 同一网段：直接填地址即可，通常能连。" />
                    <LineBreak />
                    <Run Text="· 不同楼栋、不同 VLAN：校园网路由通常不放行，连不上是正常的。" />
                    <LineBreak />
                    <Run Text="· 跨公网需要 FRP 等穿透工具，启动器不内置（与原版一致）。" />
                    <LineBreak />
                    <Run Text="· 端口探测只验证 TCP 可达，能不能进游戏还取决于对方是否已开房。" />
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="5" Text="{Binding StatusText}" FontSize="10.5"
                   Foreground="{DynamicResource Muted}" Margin="2,10,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
