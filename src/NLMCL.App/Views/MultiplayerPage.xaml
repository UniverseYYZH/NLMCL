<UserControl x:Class="NLMCL.App.Views.MultiplayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NLMCL.App"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <local:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:NullToVisibilityConverter x:Key="NullToVisibility" />

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
            </Style>

            <Style x:Key="SectionHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 整页可滚动：窗口变小时内容不再被裁掉 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0" HorizontalAlignment="Stretch">

            <!-- 服务器档案已独立成页，这里只保留直连/LAN 入口 -->
            <Border Background="{DynamicResource Surface}" CornerRadius="9" Padding="14,11" Margin="0,0,0,10"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="服务器档案在「方块宁理」页" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="宝可梦服、还原服的进入按钮与客户端要求都已移到顶部「方块宁理」；这里保留直连、局域网开房和常用线路。"
                               FontSize="10.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ===== 常用线路 ===== -->
            <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="常用线路" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="点一下用当前选中的版本直接进服（都进大厅）"
                               Style="{StaticResource SectionHint}" Margin="0,3,0,10" />

                    <ItemsControl ItemsSource="{Binding Servers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface}" Margin="0,0,8,8"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="6" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="10.5"
                                                Content="{Binding Name}"
                                                ToolTip="进入大厅（不是宝可梦子服）。要玩宝可梦内容请用上面的「进入宝可梦服」"
                                                Command="{Binding DataContext.QuickJoinCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource GhostButton}" Content="×"
                                                Padding="8,6" Margin="2,0,0,0"
                                                ToolTip="从列表移除"
                                                AutomationProperties.Name="从列表移除线路"
                                                Command="{Binding DataContext.RemoveServerCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Grid Width="170">
                            <TextBox Text="{Binding NewServerName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="11" ToolTip="显示名称" />
                            <TextBlock Text="显示名称" FontSize="10" Foreground="{DynamicResource Faint}"
                                       Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding NewServerName, Converter={StaticResource EmptyToVisibility}}" />
                        </Grid>
                        <Grid Width="210" Margin="8,0,0,0">
                            <TextBox Text="{Binding NewServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="11" ToolTip="host 或 host:port" />
                            <TextBlock Text="地址 host 或 host:port" FontSize="10"
                                       Foreground="{DynamicResource Faint}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding NewServerAddress, Converter={StaticResource EmptyToVisibility}}" />
                        </Grid>
                        <Button Content="添加" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="8,0,0,0"
                                Command="{Binding AddServerCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 局域网联机 ===== -->
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="LAN / HOST + JOIN" FontSize="9" Foreground="{DynamicResource Faint}" />
                <TextBlock Text="局域网联机" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" Margin="0,2,0,0" />
                <TextBlock Text="同一 WiFi / 同一网段才有效；跨楼、跨 VLAN 通常会被校园网隔离。"
                           Style="{StaticResource SectionHint}" Margin="0,3,0,0" />

                <StackPanel Margin="0,9,0,0">
                    <Border Style="{StaticResource CardStyle}" Padding="14,11">
                        <StackPanel>
                            <TextBlock Text="01 / HOST · 我开房" FontSize="9" FontFamily="Consolas"
                                       Foreground="{DynamicResource Primary}" />
                            <TextBlock Text="在游戏里开放到局域网" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" Margin="0,3,0,0" />
                            <TextBlock Text="游戏里按 Esc →「对局域网开放」，把聊天栏显示的端口填进来"
                                       Style="{StaticResource SectionHint}" Margin="0,3,0,8" />

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="端口" FontSize="10.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}" />
                                <TextBox Width="90" Margin="8,0,0,0" Padding="8,5" FontSize="11"
                                         Text="{Binding MyPort, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="生成地址" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Padding="12,5" Command="{Binding RefreshMyAddressCommand}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding MyAddress}" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                                <Button Content="复制" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                        Padding="12,5" Command="{Binding CopyMyAddressCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="14,11" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="02 / JOIN · 我加入" FontSize="9" FontFamily="Consolas"
                                       Foreground="{DynamicResource Primary}" />
                            <TextBlock Text="填写对方的地址" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" Margin="0,3,0,0" />
                            <TextBlock Text="填对方给你的地址（形如 10.21.3.9:54321），会先探测端口再启动"
                                       Style="{StaticResource SectionHint}" Margin="0,3,0,8" />

                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="260" Padding="8,6" FontSize="11"
                                         Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="▶  连接并启动" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Padding="14,6"
                                        Command="{Binding ConnectToLanCommand}"
                                        IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}" />
                                <Button Content="跳过探测" Style="{StaticResource GhostButton}"
                                        Margin="6,0,0,0" Padding="11,6"
                                        ToolTip="端口探测失败时仍强制启动"
                                        Command="{Binding ForceConnectCommand}"
                                        IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}" />
                                <Button Content="诊断" Style="{StaticResource GhostButton}"
                                        Margin="6,0,0,0" Padding="11,6"
                                        ToolTip="检查 DNS / SRV / 端口 / Minecraft 状态"
                                        Command="{Binding DiagnoseCommand}" />
                            </StackPanel>

                            <Border Background="{DynamicResource Surface}" CornerRadius="6" Padding="10,8"
                                    Margin="0,10,0,0">
                                <TextBlock Text="{Binding DiagnosticsText}" FontSize="10"
                                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ===== 进服须知（默认收起） ===== -->
            <Expander Margin="0,8,0,0" IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="进服须知（首次进服 / 子服准入）" Style="{StaticResource SectionHeader}" />
                </Expander.Header>

                <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,10,0,0">
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="19">
                        <Run Text="· 子服准入：宝可梦服 → 模组端；还原服等其它 → 纯净端；大厅 → 任意版本。" />
                        <LineBreak />
                        <Run Text="· 首次进宝可梦服会出现两个红色确认框，属正常：" />
                        <LineBreak />
                        <Run Text="  ① Certificate Verification → 点 Skip → 输入 I accept the risk" />
                        <LineBreak />
                        <Run Text="  ② MODPACK INSTALL（服主自制 mod）→ 勾选 → Load these unverified JARs" />
                        <LineBreak />
                        <Run Text="· 之后同步约 1 GB 整合包（网速不同，10 分钟到数小时），完成提示重启时用启动器的「重启游戏」。" />
                        <LineBreak />
                        <Run Text="· 聊天栏出现「AutoModpack mod for fabric modloader is required」= 客户端类型不对。" />
                        <LineBreak />
                        <Run Text="· 学生专线 mua.nxist.top 与 mc2/mc4 同一套导航，人少时更稳。" />
                        <LineBreak />
                        <Run Text="· 局域网扫描走多播，校园网通常拦截；扫不到不代表功能坏了。" />
                    </TextBlock>
                </Border>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
