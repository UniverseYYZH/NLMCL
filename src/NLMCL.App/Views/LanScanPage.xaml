<UserControl x:Class="NLMCL.App.Views.LanScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NLMCL.App"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="局域网扫描" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Text}" />
            <TextBlock Text="对方在游戏里选择「对局域网开放」，这里就能发现房间"
                       FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="开始扫描" Style="{StaticResource PrimaryButton}" Padding="16,7"
                        Command="{Binding ScanCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" />
                <Button Content="停止" Style="{StaticResource GhostButton}" Padding="14,7"
                        Margin="8,0,0,0" Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsScanning}" />
                <Button x:Name="QrToolbarButton" Content="地址二维码"
                        Style="{StaticResource GhostButton}" Padding="14,7"
                        Margin="8,0,0,0" Click="ShowQrFromToolbar"
                        ToolTip="没有扫描到房间时，也可以手动输入 IP:端口 生成二维码" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8" Margin="0,16,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rooms}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="8"
                                    Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Motd}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Endpoint}" FontSize="11"
                                                   Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="二维码" Style="{StaticResource GhostButton}"
                                                Padding="10,5"
                                                Click="ShowQrCode"
                                                Tag="{Binding Endpoint}"
                                                ToolTip="把这个地址生成二维码，方便手机或另一台设备复制" />
                                        <Button Content="复制地址" Style="{StaticResource GhostButton}"
                                                Padding="10,5" Margin="6,0,0,0"
                                                Command="{Binding DataContext.CopyAddressCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="2,10,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="11"
                       Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ScanDetailsText}" FontSize="9.5"
                       Foreground="{DynamicResource Faint}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding HasScanDetails, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Grid x:Name="QrOverlay" Grid.RowSpan="3" Panel.ZIndex="999"
              Background="#66000000" Visibility="Collapsed">
            <Border Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="12" Padding="20" Width="320"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="扫码复制服务器地址" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="地址（IP:端口）" FontSize="9.5"
                               Foreground="{DynamicResource Muted}" Margin="0,10,0,0" />
                    <TextBox x:Name="QrAddressBox" Margin="0,5,0,0" Padding="8,6"
                             FontSize="11" />
                    <Button Content="生成二维码" Style="{StaticResource GhostButton}"
                            Padding="12,5" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Click="RegenerateQr" />
                    <Image x:Name="QrImage" Width="240" Height="240" Margin="0,14,0,0"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock x:Name="QrAddressText" FontSize="11"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <Button Content="关闭" Style="{StaticResource GhostButton}"
                            Padding="14,6" Margin="0,14,0,0" HorizontalAlignment="Center"
                            Click="CloseQrCode" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
