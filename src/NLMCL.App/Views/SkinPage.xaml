<UserControl x:Class="NLMCL.App.Views.SkinPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NLMCL.App"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBooleanConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="皮肤" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Text}" />
            <TextBlock Text="3D 预览；皮肤由账号所属的认证服务器下发，这里只做展示与保存"
                       FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,16,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding AccountText}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" />
                <TextBlock Text="{Binding ModelText}" FontSize="11"
                           Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />

                <Border Width="320" Height="320" Margin="0,14,0,0" CornerRadius="10"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        ClipToBounds="True"
                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                    <Image Source="{Binding PreviewPath}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           MouseLeftButtonDown="OnPreviewMouseDown"
                           MouseLeftButtonUp="OnPreviewMouseUp"
                           MouseMove="OnPreviewMouseMove"
                           Cursor="SizeWE" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="◀ 左转" Style="{StaticResource GhostButton}" Padding="12,7"
                            Command="{Binding RotateLeftCommand}" />
                    <Button Content="右转 ▶" Style="{StaticResource GhostButton}" Padding="12,7"
                            Margin="6,0,0,0" Command="{Binding RotateRightCommand}" />
                    <Button Content="复位" Style="{StaticResource GhostButton}" Padding="12,7"
                            Margin="6,0,0,0" Command="{Binding ResetViewCommand}" />
                    <Button Content="自动旋转" Style="{StaticResource GhostButton}" Padding="12,7"
                            Margin="6,0,0,0" Command="{Binding ToggleAutoRotateCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="刷新" Style="{StaticResource GhostButton}" Padding="14,7"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <Button Content="打开本地皮肤" Style="{StaticResource GhostButton}" Padding="14,7"
                            Margin="8,0,0,0" Command="{Binding PickLocalCommand}" />
                    <Button Content="保存皮肤" Style="{StaticResource PrimaryButton}" Padding="14,7"
                            Margin="8,0,0,0" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11"
                   Foreground="{DynamicResource Muted}" Margin="2,12,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
