<UserControl x:Class="NLMCL.App.Views.SkinPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NLMCL.App"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
            <local:PngBytesToImageSourceConverter x:Key="PngBytesToImage" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="SKIN  /  LOCAL + MUA" FontSize="9.5"
                           FontFamily="Cascadia Mono, Consolas"
                           Foreground="{DynamicResource Faint}" Margin="0,0,0,1" />
                <TextBlock Text="皮肤库" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource Text}" />
                <TextBlock Text="本地导入与已下载皮肤收进小卡片；选中即可在右侧旋转查看 3D 效果。"
                           FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="刷新" Style="{StaticResource GhostButton}" Padding="12,7"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <Button Content="保存皮肤" Style="{StaticResource PrimaryButton}" Padding="12,7"
                        Margin="6,0,0,0" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：本地 + MUA 小卡片 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="我的皮肤库" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}" />
                                    <TextBlock Text="本地导入 · 已下载 · 第一张标记当前装配"
                                               FontSize="9.5" Foreground="{DynamicResource Faint}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="导入本地" Style="{StaticResource GhostButton}"
                                            Padding="10,5" FontSize="10" Command="{Binding PickLocalCommand}" />
                                    <Button Content="刷新" Style="{StaticResource GhostButton}"
                                            Padding="10,5" FontSize="10" Margin="4,0,0,0"
                                            Command="{Binding RefreshLocalSkinsCommand}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding LocalSkinStatusText}" FontSize="9.5"
                                       Foreground="{DynamicResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding LocalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="按本地皮肤名称搜索" Padding="7,5" FontSize="10"
                                         AutomationProperties.Name="搜索本地皮肤"
                                         Background="{DynamicResource Surface}"
                                         BorderBrush="{DynamicResource BorderColor}" />
                                <ComboBox Grid.Column="1" Margin="6,0,0,0" Padding="6,4" FontSize="10"
                                          AutomationProperties.Name="本地皮肤类型筛选"
                                          ItemsSource="{Binding LocalTypeFilters}"
                                          SelectedItem="{Binding LocalTypeFilter}" />
                                <ComboBox Grid.Column="2" Margin="6,0,0,0" Padding="6,4" FontSize="10"
                                          AutomationProperties.Name="本地皮肤使用筛选"
                                          ItemsSource="{Binding LocalUsageFilters}"
                                          SelectedItem="{Binding LocalUsageFilter}" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="排序" FontSize="9.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Faint}" />
                                <ComboBox Grid.Column="1" Width="112" Margin="6,0,0,0" Padding="6,4" FontSize="10"
                                          AutomationProperties.Name="本地皮肤排序"
                                          ItemsSource="{Binding LocalSortOptions}"
                                          SelectedItem="{Binding LocalSortOption}" />
                                <Button Grid.Column="2" Content="{Binding LocalSortDirectionLabel}"
                                        Style="{StaticResource GhostButton}" Padding="9,4" FontSize="10"
                                        HorizontalAlignment="Left" Margin="6,0,0,0"
                                        Command="{Binding ToggleLocalSortDirectionCommand}"
                                        AutomationProperties.Name="切换本地皮肤排序方向"
                                        ToolTip="切换升序 / 降序" />
                                <Button Grid.Column="3" Content="清除筛选" Style="{StaticResource GhostButton}"
                                        Padding="9,4" FontSize="9.5"
                                        AutomationProperties.Name="清除本地皮肤筛选"
                                        Click="ClearLocalFilters_Click" />
                            </Grid>
                            <ScrollViewer MaxHeight="182" Margin="0,8,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding LocalSkins}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" Width="104"
                                                    Margin="0,0,6,6" Padding="5"
                                                    Command="{Binding DataContext.UseLocalSkinCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding AcquiredLabel}" />
                                                        <TextBlock Text="{Binding LastUsedLabel}" />
                                                        <TextBlock Text="{Binding UsageLabel}" />
                                                        <TextBlock Text="{Binding ModelLabel}" />
                                                    </StackPanel>
                                                </Button.ToolTip>
                                                <StackPanel>
                                                    <Grid Height="54">
                                                        <Image Source="{Binding Path}" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        <Image Source="{Binding PreviewPng, Converter={StaticResource PngBytesToImage}}"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                                                        <Border Background="{DynamicResource Primary}"
                                                                CornerRadius="4" Padding="4,1"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="已装配" FontSize="8"
                                                                       Foreground="{DynamicResource OnPrimary}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="9.5"
                                                               Foreground="{DynamicResource Text}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding PreviewLabel}" FontSize="8"
                                                               Foreground="{DynamicResource Faint}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MUA 皮肤站" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}" />
                                    <TextBlock Text="{Binding LibraryStatusText}" FontSize="9.5"
                                               Foreground="{DynamicResource Faint}" Margin="0,3,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="‹" Style="{StaticResource GhostButton}"
                                            Width="24" Height="24" Padding="0" FontSize="13"
                                            Command="{Binding PrevLibraryPageCommand}"
                                            AutomationProperties.Name="MUA 上一页"
                                            ToolTip="上一页"
                                            IsEnabled="{Binding IsLibraryBusy, Converter={StaticResource InverseBool}}" />
                                    <TextBlock VerticalAlignment="Center" Margin="7,0" FontSize="9"
                                               Foreground="{DynamicResource Muted}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} / {1}">
                                                <Binding Path="LibraryPage" Mode="OneWay" />
                                                <Binding Path="LibraryLastPage" Mode="OneWay" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Button Content="›" Style="{StaticResource GhostButton}"
                                            Width="24" Height="24" Padding="0" FontSize="13"
                                            Command="{Binding NextLibraryPageCommand}"
                                            AutomationProperties.Name="MUA 下一页"
                                            ToolTip="下一页"
                                            IsEnabled="{Binding IsLibraryBusy, Converter={StaticResource InverseBool}}" />
                                    <Button Content="刷新" Style="{StaticResource GhostButton}"
                                            Padding="9,4" FontSize="9" Margin="8,0,0,0"
                                            Command="{Binding RefreshLibraryCommand}"
                                            AutomationProperties.Name="刷新 MUA 皮肤站"
                                            IsEnabled="{Binding IsLibraryBusy, Converter={StaticResource InverseBool}}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Padding="5,4" FontSize="9.5"
                                          AutomationProperties.Name="MUA 搜索方式"
                                          ItemsSource="{Binding MuaSearchModes}"
                                          SelectedItem="{Binding MuaSearchMode}" />
                                <TextBox Grid.Column="1" Margin="6,0,0,0" Padding="7,5" FontSize="10"
                                         Text="{Binding MuaSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding MuaSearchHint}"
                                         AutomationProperties.Name="搜索 MUA 皮肤"
                                         Background="{DynamicResource Surface}"
                                         BorderBrush="{DynamicResource BorderColor}" />
                                <Button Grid.Column="2" Content="搜索" Style="{StaticResource GhostButton}"
                                        Padding="10,4" FontSize="9.5" Margin="6,0,0,0"
                                        Command="{Binding SearchLibraryCommand}"
                                        IsEnabled="{Binding IsLibraryBusy, Converter={StaticResource InverseBool}}" />
                                <Button Grid.Column="3" Content="清除" Style="{StaticResource GhostButton}"
                                        Padding="8,4" FontSize="9" Margin="4,0,0,0"
                                        Command="{Binding ClearLibrarySearchCommand}" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="筛选" FontSize="9.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Faint}" />
                                <ComboBox Grid.Column="1" Margin="6,0,0,0" Padding="5,4" FontSize="9.5"
                                          AutomationProperties.Name="MUA 皮肤类型筛选"
                                          ItemsSource="{Binding MuaTypeFilters}"
                                          SelectedItem="{Binding MuaTypeFilter}" />
                                <TextBlock Grid.Column="2" Text="排序" FontSize="9.5" VerticalAlignment="Center"
                                           Margin="10,0,0,0" Foreground="{DynamicResource Faint}" />
                                <ComboBox Grid.Column="3" Margin="6,0,0,0" Padding="5,4" FontSize="9.5"
                                          AutomationProperties.Name="MUA 皮肤排序"
                                          ItemsSource="{Binding MuaSortOptions}"
                                          SelectedItem="{Binding MuaSortOption}" />
                                <Button Grid.Column="4" Content="{Binding MuaSortDirectionLabel}"
                                        Style="{StaticResource GhostButton}" Padding="9,4" FontSize="10"
                                        HorizontalAlignment="Left" Margin="6,0,0,0"
                                        Command="{Binding ToggleMuaSortDirectionCommand}"
                                        AutomationProperties.Name="切换 MUA 排序方向"
                                        ToolTip="切换升序 / 降序" />
                            </Grid>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8" Margin="0,8,0,0"
                                    Visibility="{Binding HasPlayerSkinResult, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding PlayerSkinName}" FontSize="11.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                                    <TextBlock Text="{Binding PlayerSkinStatus}" FontSize="9.5"
                                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                    <Button Content="在 3D 中查看" Style="{StaticResource GhostButton}"
                                            Padding="10,4" FontSize="9.5" Margin="0,6,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding PreviewPlayerSkinCommand}"
                                            IsEnabled="{Binding IsPlayerSkinBusy, Converter={StaticResource InverseBool}}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="9" Padding="16,14" Margin="0,8,0,0" MinHeight="138"
                                    Visibility="{Binding ShowMuaEmptyState, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                               Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="MUA 皮肤站暂时没有内容" FontSize="11.5" Margin="0,6,0,0"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="检查网络后点“刷新”；也可以先把本地 PNG 导进来。"
                                               FontSize="9.5" Foreground="{DynamicResource Muted}"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <ScrollViewer MaxHeight="238" Margin="0,8,0,0"
                                          Visibility="{Binding HasLibrarySkins, Converter={StaticResource BoolToVisibility}}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding LibrarySkins}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Surface}"
                                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                    CornerRadius="8" Padding="5" Margin="0,0,6,6" Width="112">
                                                <StackPanel>
                                                    <Grid>
                                                        <Button Style="{StaticResource GhostButton}" Padding="3"
                                                                Click="PreviewLibrarySkin_Click"
                                                                ToolTip="下载并 3D 预览这张 MUA 皮肤">
                                                            <Image Source="{Binding PreviewUrl}" Height="56" Width="56"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Button>
                                                        <Border Background="{DynamicResource Amber}" CornerRadius="6"
                                                                Padding="5,1" Margin="0,3,3,0"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                ToolTip="收藏数">
                                                            <TextBlock Text="{Binding LikesText}" FontSize="8.5"
                                                                       FontWeight="SemiBold" Foreground="#FFF8EC" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="9.5"
                                                               Foreground="{DynamicResource Text}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                    <Grid Margin="0,1,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding UploaderText}" FontSize="8"
                                                                   Foreground="{DynamicResource Faint}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding LikesText}"
                                                                   FontSize="8" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Amber}" />
                                                    </Grid>
                                                    <Button Content="装配" Style="{StaticResource GhostButton}"
                                                            Padding="6,3" FontSize="9" Margin="0,4,0,0"
                                                            HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.ApplyLibrarySkinCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.CanApplyLibrarySkins,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧：3D 预览优先 + 紧凑账号条 -->
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <Border Style="{StaticResource CardStyle}" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="3D 预览" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <Border Background="{DynamicResource PrimarySoft}" CornerRadius="6" Padding="7,2"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="实时 3D" FontSize="8.5"
                                           Foreground="{DynamicResource Primary}" />
                            </Border>
                        </Grid>
                        <Border Height="265" Margin="0,9,0,0" CornerRadius="10"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding PreviewPng, Converter={StaticResource PngBytesToImage}}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       MouseLeftButtonDown="OnPreviewMouseDown"
                                       MouseLeftButtonUp="OnPreviewMouseUp"
                                       MouseMove="OnPreviewMouseMove"
                                       Cursor="SizeWE"
                                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="还没有选中皮肤" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                                    <TextBlock Text="选择左侧本地皮肤或 MUA 卡片查看 3D 预览"
                                               FontSize="9.5" Foreground="{DynamicResource Faint}"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <UniformGrid Columns="4" Margin="0,9,0,0">
                            <Button Content="◀ 左转" Style="{StaticResource GhostButton}" Padding="0,7"
                                    FontSize="10" Margin="0,0,4,0" Command="{Binding RotateLeftCommand}" />
                            <Button Content="右转 ▶" Style="{StaticResource GhostButton}" Padding="0,7"
                                    FontSize="10" Margin="0,0,4,0" Command="{Binding RotateRightCommand}" />
                            <Button Content="复位" Style="{StaticResource GhostButton}" Padding="0,7"
                                    FontSize="10" Margin="0,0,4,0" Command="{Binding ResetViewCommand}" />
                            <Button Content="自动旋转" Style="{StaticResource GhostButton}" Padding="0,7"
                                    FontSize="10" Command="{Binding ToggleAutoRotateCommand}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="13,10" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding AccountText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock Text="{Binding ModelText}" FontSize="9.5"
                                       Foreground="{DynamicResource Muted}" Margin="0,2,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding StatusText}" FontSize="9.5"
                                       Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="查同名正版" Style="{StaticResource GhostButton}"
                                Padding="10,5" FontSize="9.5" VerticalAlignment="Center"
                                Command="{Binding QueryByNameCommand}"
                                Visibility="{Binding IsOfflineAccount, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,9,0,0">
            <TextBlock Text="本地 PNG 建议 64×64 · 点卡片即可预览" FontSize="9.5"
                       Foreground="{DynamicResource Faint}" HorizontalAlignment="Left" />
            <TextBlock Text="MUA 装配前会先下载到皮肤目录" FontSize="9.5"
                       Foreground="{DynamicResource Faint}" HorizontalAlignment="Right" />
        </Grid>

    </Grid>
</UserControl>
