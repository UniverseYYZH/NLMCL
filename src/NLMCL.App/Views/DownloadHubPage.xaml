<UserControl x:Class="NLMCL.App.Views.DownloadHubPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NLMCL.App.Views"
             FontFamily="{DynamicResource UiFont}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HubTab" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="15,7" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoft}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="26,16,26,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="DownloadTab" Content="游戏版本" Style="{StaticResource HubTab}"
                    Tag="active" Click="DownloadTab_Click" />
            <Button x:Name="ResourceTab" Content="导入资源" Style="{StaticResource HubTab}"
                    Click="ResourceTab_Click" />
            <Button x:Name="ModsTab" Content="Mod 管理" Style="{StaticResource HubTab}"
                    Click="ModsTab_Click" />
            <TextBlock Text="下载中心 · 资源与 Mod 已合并到这里"
                       FontSize="9.5" Foreground="{DynamicResource Faint}"
                       VerticalAlignment="Center" Margin="12,1,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <views:DownloadPage x:Name="DownloadView" DataContext="{Binding Download}" />
            <views:ResourcePage x:Name="ResourceView" DataContext="{Binding Resource}" Visibility="Collapsed" />
            <views:ModPage x:Name="ModView" DataContext="{Binding Mods}" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
