<UserControl x:Class="NLMCL.App.Views.ModPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NLMCL.App"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBooleanConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding InstanceText}" FontSize="11.5"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal">
                <Button Content="刷新" Style="{StaticResource GhostButton}" Padding="14,7"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <Button Content="检查更新" Style="{StaticResource GhostButton}" Padding="14,7"
                        Margin="8,0,0,0" Command="{Binding CheckUpdatesCommand}" />
                <Button Content="打开 mods 目录" Style="{StaticResource GhostButton}" Padding="14,7"
                        Margin="8,0,0,0" Command="{Binding OpenModsFolderCommand}" />
                <TextBlock Text="{Binding ModsDirectoryText}" FontSize="9.5"
                           Foreground="{DynamicResource Faint}" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           MaxWidth="520" ToolTip="{Binding ModsDirectoryText}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8" Margin="0,16,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Mods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="8"
                                    Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13.5"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource Muted}"
                                                   Margin="0,3,0,0" TextWrapping="Wrap">
                                            <Run Text="{Binding Version, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Loader, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding SizeText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding StateText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding UpdateText}" FontSize="10.5"
                                                   Foreground="{DynamicResource Primary}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding DependencyText}" FontSize="10.5"
                               Foreground="{DynamicResource Error}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasMissingDependencies, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="启用/禁用" Style="{StaticResource GhostButton}"
                                                Padding="10,5"
                                                Command="{Binding DataContext.ToggleCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="删除" Style="{StaticResource GhostButton}"
                                                Padding="10,5" Margin="6,0,0,0"
                                                Command="{Binding DataContext.DeleteCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11"
                   Foreground="{DynamicResource Muted}" Margin="2,10,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
