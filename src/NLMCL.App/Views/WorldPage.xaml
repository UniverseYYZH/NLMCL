<UserControl x:Class="NLMCL.App.Views.WorldPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NLMCL.App"
             FontFamily="{DynamicResource UiFont}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:NullToVisibilityConverter x:Key="NullToVisibility" />

            <Style x:Key="WorldKicker" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            </Style>

            <Style x:Key="FactLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            </Style>

            <Style x:Key="FactValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="Margin" Value="0,5,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="None" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,18,26,12">

            <!-- 页头 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="WORLD  /  INSTANCE DOSSIER" Style="{StaticResource WorldKicker}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding SelectedVersion.Name, TargetNullValue=世界}"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="38" Foreground="{DynamicResource Text}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="WORLD DOSSIER" FontFamily="{DynamicResource DisplayFont}"
                                   FontStyle="Italic" FontSize="22" Foreground="{DynamicResource Faint}"
                                   Margin="12,10,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="世界/实例的配置、模组、启动参数与本地快照。只保存在这台电脑。"
                               FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="版本详情" Style="{StaticResource GhostButton}" Padding="14,8"
                            Command="{Binding ShowVersionDetailsCommand}"
                            CommandParameter="{Binding SelectedVersion}" />
                    <Button Content="启动设置" Style="{StaticResource GhostButton}" Padding="14,8"
                            Margin="8,0,0,0" Click="OpenLaunchSettings_Click" />
                    <Button Content="修复" Style="{StaticResource GhostButton}" Padding="14,8"
                            Margin="8,0,0,0" Command="{Binding RepairSelectedCommand}"
                            IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}" />
                    <Button Content="▶  启动世界" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Margin="8,0,0,0" Command="{Binding LaunchSelectedCommand}"
                            IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <!-- 当前世界 banner -->
            <Border Grid.Row="0" Grid.Column="0" CornerRadius="14" Padding="24,22" Margin="0,0,16,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#27483F" Offset="0" />
                        <GradientStop Color="#1C332E" Offset="0.58" />
                        <GradientStop Color="#162923" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CURRENT WORLD  /  OFFLINE READY" FontFamily="{DynamicResource MonoFont}"
                                   FontSize="10" Foreground="#D7C68C" />
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <TextBlock Text="{Binding SelectedVersion.Name, TargetNullValue=未选择世界}"
                                       FontFamily="{DynamicResource DisplayFont}" FontSize="31"
                                       Foreground="#FFF9EC" TextTrimming="CharacterEllipsis" />
                            <Border Background="#33F8D818" BorderBrush="#66F8D818" BorderThickness="1"
                                    CornerRadius="7" Padding="8,3" Margin="12,7,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedVersion.KindLabel, TargetNullValue=本地实例}"
                                           FontSize="10" Foreground="#F8D818" />
                            </Border>
                        </StackPanel>

                        <TextBlock Foreground="#D8E4DC" FontSize="12" Margin="0,9,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="Minecraft " /><Run Text="{Binding SelectedVersion.MinecraftVersion, Mode=OneWay}" />
                            <Run Text="  ·  " /><Run Text="{Binding SelectedVersion.LoaderHint, Mode=OneWay}" />
                            <Run Text="  ·  " /><Run Text="{Binding Mods.Mods.Count, Mode=OneWay, FallbackValue=0, TargetNullValue=0}" /><Run Text=" 个模组" />
                        </TextBlock>

                        <Border Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                                CornerRadius="7" Padding="9,5" Margin="0,13,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedVersion.InstancePath}" FontFamily="{DynamicResource MonoFont}"
                                       FontSize="9.5" Foreground="#CFE1D7" TextTrimming="CharacterEllipsis"
                                       MaxWidth="380" ToolTip="{Binding SelectedVersion.InstancePath}" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="▶  启动世界" Style="{StaticResource PrimaryButton}" Padding="18,10"
                                    Background="{DynamicResource FrameYellow}" Foreground="{DynamicResource FrameRedDeep}"
                                    BorderBrush="{DynamicResource FrameYellow}" FontWeight="SemiBold"
                                    Command="{Binding LaunchSelectedCommand}"
                                    IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}" />
                            <Button Content="打开目录" Style="{StaticResource GhostButton}" Padding="16,10"
                                    Margin="8,0,0,0" Command="{Binding OpenGameDirectoryCommand}" />
                            <Button Content="创建快照" Style="{StaticResource GhostButton}" Padding="16,10"
                                    Margin="8,0,0,0" Command="{Binding CreateSnapshotCommand}" />
                            <Button Content="安全模式" Style="{StaticResource GhostButton}" Padding="16,10"
                                    Margin="8,0,0,0" Command="{Binding LaunchSafeModeCommand}"
                                    IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}"
                                    ToolTip="本次启动禁用全部 Mod，游戏退出或启动失败后自动恢复" />
                        </StackPanel>

                        <Border Background="#1FF8D818" BorderBrush="#66F8D818" BorderThickness="1"
                                CornerRadius="8" Padding="10,7" Margin="0,10,0,0"
                                Visibility="{Binding HasSafeModeMessage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SafeModeMessage}" FontSize="11"
                                       Foreground="#FFF3C4" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <!-- 右侧抽象世界插画 -->
                    <Grid Grid.Column="1" Margin="16,0,0,0" ClipToBounds="True">
                        <Ellipse Width="92" Height="92" Fill="#22F8D818" HorizontalAlignment="Right"
                                 VerticalAlignment="Top" Margin="0,-22,-16,0" />
                        <Path Data="M 0,150 L 58,86 L 108,132 L 156,72 L 232,150 Z"
                              Fill="#2E6A58" Stretch="Fill" Height="118" VerticalAlignment="Bottom" />
                        <Path Data="M 0,170 L 48,124 L 96,154 L 154,110 L 226,170 Z"
                              Fill="#3E8069" Stretch="Fill" Height="92" VerticalAlignment="Bottom" />
                        <Border Width="46" Height="46" Background="#1E3A31" BorderBrush="#6E9C84"
                                BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center"
                                VerticalAlignment="Bottom" Margin="0,0,36,20">
                            <Grid>
                                <Rectangle Height="9" Fill="#5D8B70" VerticalAlignment="Top" />
                                <Rectangle Width="9" Height="10" Fill="#7AA68B" HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom" Margin="7,0,0,7" />
                                <Rectangle Width="9" Height="10" Fill="#7AA68B" HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom" Margin="19,0,0,7" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Facts -->
            <UniformGrid Grid.Row="1" Grid.Column="0" Columns="4" Margin="0,0,16,16">
                <Border Style="{StaticResource CardStyle}" Padding="16,13" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="JAVA  /  运行时" Style="{StaticResource FactLabel}" />
                        <TextBlock Text="{Binding EffectiveJavaText}" Style="{StaticResource FactValue}"
                                   ToolTip="{Binding EffectiveJavaText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16,13" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="MEMORY  /  分配内存" Style="{StaticResource FactLabel}" />
                        <TextBlock Text="{Binding MemoryMb, StringFormat={}{0} MB}" Style="{StaticResource FactValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16,13" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="最后启动" Style="{StaticResource FactLabel}"
                                   ToolTip="LAST PLAYED" />
                        <TextBlock Text="{Binding SelectedVersion.LastLaunchLabel, TargetNullValue=从未启动}"
                                   Style="{StaticResource FactValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="VERSION  /  实例类型" Style="{StaticResource FactLabel}" />
                        <TextBlock Text="{Binding SelectedVersion.KindLabel, TargetNullValue=本地实例}"
                                   Style="{StaticResource FactValue}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Mods -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,0,16,0"
                    VerticalAlignment="Stretch">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MODS  /  LOCAL" FontFamily="{DynamicResource MonoFont}"
                                       FontSize="10" Foreground="{DynamicResource Faint}" />
                            <TextBlock Text="已安装模组" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="打开 mods" Style="{StaticResource GhostButton}" Padding="12,7"
                                    Command="{Binding Mods.OpenModsFolderCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="当前实例的模组列表。只显示本地实际存在的 jar；启用状态来自文件名。"
                               FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Mods.Mods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                                        Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" IsHitTestVisible="False"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FileName}" FontFamily="{DynamicResource MonoFont}"
                                                       FontSize="9.5" Foreground="{DynamicResource Muted}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="启用 / 禁用" Style="{StaticResource GhostButton}"
                                                Padding="10,5" FontSize="10.5" VerticalAlignment="Center"
                                                Command="{Binding DataContext.Mods.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="10" Padding="22,26" MinHeight="220"
                            Visibility="{Binding Mods.HasMods, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                       Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" />
                            <TextBlock Text="这个实例还没有模组" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" Margin="0,10,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="把 jar 放进 mods 目录，或去下载中心找 Mod；只显示本地实际存在的文件。"
                                       FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="330" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Button Content="打开 mods" Style="{StaticResource GhostButton}" Padding="12,7"
                                        FontSize="11" Command="{Binding Mods.OpenModsFolderCommand}" />
                                <Button Content="去下载中心" Style="{StaticResource GhostButton}" Padding="12,7"
                                        FontSize="11" Margin="6,0,0,0" Click="GoDownload_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

                <StackPanel Grid.RowSpan="3" Grid.Column="1">
                    <Border Background="#FFF4D6" BorderBrush="#E0B84A" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                            Visibility="{Binding HasEnvironmentWarning, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding EnvironmentWarning}" FontSize="10.5"
                                   Foreground="#6B4A00" TextWrapping="Wrap" />
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="本机档案" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="11" Foreground="{DynamicResource Faint}" />
                                <TextBlock Text="A-001" FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                           Foreground="{DynamicResource Faint}" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,9,0,0">
                                <TextBlock Text="{Binding SelectedVersion.InstancePath, TargetNullValue=未选择实例}"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="9.5"
                                           Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedVersion.InstancePath}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="复制路径" Style="{StaticResource GhostButton}" Padding="10,6"
                                        FontSize="10.5" Click="CopyInstancePath_Click" />
                                <Button Content="扫描" Style="{StaticResource GhostButton}" Padding="10,6"
                                        FontSize="10.5" Margin="5,0,0,0" Command="{Binding RescanCommand}" />
                                <Button Content="打开" Style="{StaticResource GhostButton}" Padding="10,6"
                                        FontSize="10.5" Margin="5,0,0,0" Command="{Binding OpenGameDirectoryCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="截图" Style="{StaticResource GhostButton}" Padding="10,6"
                                        FontSize="10.5" Tag="screenshots"
                                        Click="OpenInstanceSubfolder_Click"
                                        ToolTip="打开当前实例的截图文件夹" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="启动预检 / PREFLIGHT" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="10.5" Foreground="{DynamicResource Faint}" />
                                <Button Content="重新检查" Style="{StaticResource GhostButton}" Padding="7,4"
                                        FontSize="9.5" HorizontalAlignment="Right"
                                        IsEnabled="{Binding IsLaunchPreflightBusy, Converter={StaticResource InverseBool}}"
                                        Command="{Binding RefreshLaunchPreflightCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding LaunchPreflightSummary}" FontSize="11"
                                       Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <Border Margin="0,6,0,0" Padding="9,7" CornerRadius="6"
                                    Background="{DynamicResource AmberBg}"
                                    BorderBrush="{DynamicResource AmberBorder}" BorderThickness="1"
                                    Visibility="{Binding HasLaunchPreflightWarnings, Converter={StaticResource BoolToVisibility}}">
                                <ScrollViewer MaxHeight="108" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding LaunchPreflightWarnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="10" Foreground="{DynamicResource Text}"
                                                           TextWrapping="Wrap" Margin="0,0,0,4">
                                                    <Run Text="• " />
                                                    <Run Text="{Binding Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10"
                            Visibility="{Binding HasModpackUpdateMessage, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="整合包 / MODPACK" FontFamily="{DynamicResource MonoFont}"
                                       FontSize="10.5" Foreground="{DynamicResource Faint}" />
                            <TextBlock Text="{Binding ModpackUpdateMessage}" FontSize="10.5"
                                       Foreground="{DynamicResource Text}" TextWrapping="Wrap"
                                       Margin="0,7,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="检查更新" Style="{StaticResource GhostButton}" Padding="8,5"
                                        FontSize="9.5"
                                        Command="{Binding CheckModpackUpdateCommand}"
                                        IsEnabled="{Binding IsModpackUpdateBusy, Converter={StaticResource InverseBool}}"
                                        ToolTip="只检查 Modrinth 来源的整合包，不会自动替换实例" />
                                <Button Content="备份整合包" Style="{StaticResource GhostButton}" Padding="8,5"
                                        FontSize="9.5" Margin="6,0,0,0"
                                        Command="{Binding BackupModpackCommand}"
                                        IsEnabled="{Binding IsModpackUpdateBusy, Converter={StaticResource InverseBool}}"
                                        ToolTip="把当前实例导出到数据目录的 modpack-backups" />
                                <Button Content="安装更新" Style="{StaticResource PrimaryButton}" Padding="10,5"
                                        FontSize="9.5" Margin="6,0,0,0"
                                        Command="{Binding ApplyModpackUpdateCommand}"
                                        IsEnabled="{Binding IsModpackUpdateBusy, Converter={StaticResource InverseBool}}"
                                        Visibility="{Binding CanApplyModpackUpdate, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="先备份，再下载新版并原地更新；失败不会改动原实例" />
                                <Button Content="回滚备份" Style="{StaticResource GhostButton}" Padding="8,5"
                                        FontSize="9.5" Margin="6,0,0,0"
                                        Command="{Binding RollbackModpackUpdateCommand}"
                                        IsEnabled="{Binding IsModpackUpdateBusy, Converter={StaticResource InverseBool}}"
                                        Visibility="{Binding HasModpackBackup, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="把当前实例恢复到刚才自动备份的状态" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="实例内容 / CONTENT" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="10.5" Foreground="{DynamicResource Faint}" />
                                <Button Content="刷新" Style="{StaticResource GhostButton}" Padding="7,4"
                                        FontSize="9.5" HorizontalAlignment="Right"
                                        Command="{Binding RefreshInstanceContentCommand}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="存档" FontSize="11.5" Foreground="{DynamicResource Text}" />
                                    <TextBlock Text="{Binding SaveSlotCount, StringFormat={}{0} 个世界}"
                                               FontSize="9.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="打开" Style="{StaticResource GhostButton}"
                                        Padding="7,5" FontSize="9.5" Tag="saves"
                                        Click="OpenInstanceSubfolder_Click" />
                                <Button Grid.Column="2" Content="导入" Style="{StaticResource GhostButton}"
                                        Padding="7,5" FontSize="9.5" Margin="4,0,0,0"
                                        Command="{Binding ImportSaveCommand}" />
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="资源包" FontSize="11.5" Foreground="{DynamicResource Text}" />
                                    <TextBlock Text="{Binding ResourcePackCount, StringFormat={}{0} 个}"
                                               FontSize="9.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="打开" Style="{StaticResource GhostButton}"
                                        Padding="7,5" FontSize="9.5" Tag="resourcepacks"
                                        Click="OpenInstanceSubfolder_Click" />
                                <Button Grid.Column="2" Content="导入" Style="{StaticResource GhostButton}"
                                        Padding="7,5" FontSize="9.5" Margin="4,0,0,0"
                                        Command="{Binding ImportResourcePackCommand}" />
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="光影包" FontSize="11.5" Foreground="{DynamicResource Text}" />
                                    <TextBlock Text="{Binding ShaderPackCount, StringFormat={}{0} 个}"
                                               FontSize="9.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="打开" Style="{StaticResource GhostButton}"
                                        Padding="7,5" FontSize="9.5" Tag="shaderpacks"
                                        Click="OpenInstanceSubfolder_Click" />
                                <Button Grid.Column="2" Content="导入" Style="{StaticResource GhostButton}"
                                        Padding="7,5" FontSize="9.5" Margin="4,0,0,0"
                                        Command="{Binding ImportShaderPackCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="本地快照" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}" />
                                <TextBlock Text="{Binding Snapshots.Count, StringFormat={}{0} SAVED}"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="9.5"
                                           Foreground="{DynamicResource Faint}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Snapshots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                                                Padding="0,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Summary}" FontSize="9.5"
                                                           Foreground="{DynamicResource Muted}" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="管理快照" Style="{StaticResource GhostButton}" Padding="10,6"
                                        FontSize="10.5" Command="{Binding GoToSnapshotsCommand}" />
                                <Button Content="新建" Style="{StaticResource GhostButton}" Padding="10,6"
                                        FontSize="10.5" Margin="5,0,0,0" Command="{Binding CreateSnapshotCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="启动设置 / INSTANCE" FontFamily="{DynamicResource MonoFont}"
                                       FontSize="10.5" Foreground="{DynamicResource Faint}" />
                            <Border Background="{DynamicResource AmberBg}" BorderBrush="{DynamicResource AmberBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,7,0,0"
                                    Visibility="{Binding HasRunningSelectedInstance, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding MultiInstanceWarning}" TextWrapping="Wrap"
                                           FontSize="10" Foreground="{DynamicResource Text}" />
                            </Border>
                            <Expander Header="编辑内存 / 窗口 / 参数" Margin="0,7,0,0" IsExpanded="False">
                                <StackPanel x:Name="InstanceSettingsEditor" Margin="0,6,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRunningSelectedInstance}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="内存 MB" Foreground="{DynamicResource Muted}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="10" Padding="6,4"
                                                 AutomationProperties.Name="实例内存（MB）" />
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="窗口" Foreground="{DynamicResource Muted}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}" Width="48"
                                                     FontSize="10" Padding="4,4"
                                                     AutomationProperties.Name="游戏窗口宽度" />
                                            <TextBlock Text="×" Foreground="{DynamicResource Muted}" Margin="5,0"
                                                       VerticalAlignment="Center" />
                                            <TextBox Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}" Width="48"
                                                     FontSize="10" Padding="4,4"
                                                     AutomationProperties.Name="游戏窗口高度" />
                                            <CheckBox Content="全屏" IsChecked="{Binding Fullscreen}" FontSize="10"
                                                      Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="额外参数" Foreground="{DynamicResource Muted}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="10" Padding="6,4"
                                                 AutomationProperties.Name="额外游戏参数" />
                                    </Grid>
                                    <Button Content="保存启动设置" Style="{StaticResource GhostButton}" Padding="10,6"
                                            FontSize="10.5" HorizontalAlignment="Left"
                                            Command="{Binding SaveSettingsCommand}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="实例操作" FontFamily="{DynamicResource MonoFont}"
                                       FontSize="10.5" Foreground="{DynamicResource Faint}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Content="重命名" Style="{StaticResource GhostButton}" Padding="8,6"
                                        FontSize="10.5" Command="{Binding RenameVersionCommand}" />
                                <Button Content="复制" Style="{StaticResource GhostButton}" Padding="8,6"
                                        FontSize="10.5" Margin="4,0,0,0" Grid.Column="1" Command="{Binding CopyVersionCommand}" />
                                <Button Content="导出实例包" Style="{StaticResource GhostButton}" Padding="8,6"
                                        FontSize="10.5" Margin="0,4,0,0" Grid.Row="1" Command="{Binding ExportInstanceCommand}"
                                        ToolTip="导出当前实例（不含 logs 与 crash-reports）" />
                                <Button Content="导入实例包" Style="{StaticResource GhostButton}" Padding="8,6"
                                        FontSize="10.5" Margin="4,4,0,0" Grid.Row="1" Grid.Column="1" Command="{Binding ImportInstanceCommand}"
                                        ToolTip="从 .zip 实例包恢复为新实例" />
                                <Button Content="删除实例" Style="{StaticResource GhostButton}" Padding="8,6"
                                        FontSize="10.5" Margin="0,4,0,0" Grid.Row="2" Grid.ColumnSpan="2"
                                        Foreground="#A23A32" Command="{Binding DeleteVersionCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="服务器准备 / AUTO" FontFamily="{DynamicResource MonoFont}"
                                       FontSize="10.5" Foreground="{DynamicResource Faint}" />
                            <TextBlock Text="进入宝可梦服需要 1.21.1 + Fabric + AutoModpack；联机页可自动准备，不会影响这个实例的模组。"
                                       FontSize="10.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <Button Content="去联机" Style="{StaticResource GhostButton}" Padding="10,6"
                                    FontSize="10.5" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Click="GoMultiplayer_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
