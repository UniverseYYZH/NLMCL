<UserControl x:Class="NLMCL.App.Views.ResourcePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NLMCL.App"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <local:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />

            <DataTemplate x:Key="ResourceItemTemplate">
                <Border Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                Background="{DynamicResource Surface}">
                            <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Description}" FontSize="10" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                            <TextBlock FontSize="9.5" Foreground="{DynamicResource Faint}" Margin="0,3,0,0">
                                <Run Text="{Binding DownloadsText, Mode=OneWay}" /><Run Text=" 次下载 · " /><Run Text="{Binding Slug, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="2" Content="安装" Style="{StaticResource PrimaryButton}"
                                Padding="14,6" VerticalAlignment="Center"
                                Command="{Binding DataContext.InstallCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="导入资源" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Text}" />
            <TextBlock Text="从 Modrinth 搜索模组 / 资源包 / 光影 / 数据包，一键装进当前实例"
                       FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,16,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="7" Padding="10,7">
                    <Grid>
                        <TextBlock Text="搜索（例如 sodium、Iris、faithful）" FontSize="11.5"
                                   Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="11.5"
                                 Foreground="{DynamicResource Text}" />
                    </Grid>
                </Border>

                <ComboBox Grid.Column="1" Width="110" Margin="10,0,0,0"
                          ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" />

                <ComboBox Grid.Column="2" Width="120" Margin="8,0,0,0"
                          ItemsSource="{Binding LoaderOptions}" SelectedItem="{Binding SelectedLoader}"
                          Visibility="{Binding IsModKind, Converter={StaticResource BoolToVisibility}}" />

                <Border Grid.Column="3" Background="{DynamicResource Surface}" Margin="8,0,0,0"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="7" Padding="10,7" Width="110">
                    <Grid>
                        <TextBlock Text="游戏版本" FontSize="11" Foreground="{DynamicResource Faint}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding GameVersion, Converter={StaticResource EmptyToVisibility}}" />
                        <TextBox Text="{Binding GameVersion, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="11"
                                 Foreground="{DynamicResource Text}" />
                    </Grid>
                </Border>

                <Button Grid.Column="4" Content="搜索" Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" Padding="16,7" Command="{Binding SearchCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                <Button Grid.Column="5" Content="导入整合包" Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0" Padding="12,7"
                        Command="{Binding ImportModpackCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </Grid>
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding Results}"
                 ItemTemplate="{StaticResource ResourceItemTemplate}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch" SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>


        <!-- 结果计数 + 加载更多：Modrinth 一页 20 条，翻页按钮避免"怎么只有 20 个" -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,10,0,0">
            <TextBlock Text="{Binding ResultsCountText}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource Muted}" />
            <Button Content="加载更多" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                    Padding="12,5" FontSize="10.5"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding LoadMoreCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="2,10,0,0">
            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Progress}"
                         Foreground="{DynamicResource Primary}" Background="{DynamicResource Surface}"
                         Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" FontSize="11"
                       Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
