<UserControl x:Class="NLMCL.App.Views.SnapshotPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NLMCL.App"
             FontFamily="{DynamicResource UiFont}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBooleanConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22,26,20" MaxWidth="980" HorizontalAlignment="Stretch">

            <TextBlock Text="实例快照" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource Text}" />
            <TextBlock Text="把存档、配置、选项备份一份；折腾坏了可以退回来。不含 mods / 资源包。"
                       FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap" />

            <!-- 当前实例 + 占用 -->
            <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="当前实例" FontSize="10" Foreground="{DynamicResource Faint}" />
                        <TextBlock Text="{Binding SelectedVersion.Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding SnapshotTotalText}" FontSize="10.5"
                                   Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />

                        <TextBlock Text="请先在「本地版本」里点选一个实例，这里才会显示它的快照"
                                   FontSize="10.5" Foreground="#C62828" Margin="0,6,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedVersion}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="刷新" Style="{StaticResource GhostButton}" Padding="12,6"
                                Command="{Binding RefreshSnapshotsCommand}" />
                        <Button Content="清空全部" Style="{StaticResource GhostButton}" Padding="12,6" Margin="8,0,0,0"
                                ToolTip="删除这个实例的所有快照"
                                Command="{Binding ClearSnapshotsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 新建 -->
            <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="新建快照" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="写一句备注，之后能一眼看出这份备份是干什么用的"
                               FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,3,0,8" />

                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="360" Padding="9,7" FontSize="11"
                                 ToolTip="例如：装宝可梦整合包之前"
                                 Text="{Binding SnapshotNote, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="创建快照" Margin="10,0,0,0" Padding="16,7"
                                Command="{Binding CreateSnapshotCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSnapshotBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedVersion}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 列表 -->
            <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="已有快照" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="恢复会先把当前状态存成一份保护快照，所以回滚本身也能反悔"
                               FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,3,0,10" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding Snapshots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface}" CornerRadius="7" Padding="12,10"
                                        Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" FontSize="10"
                                                       Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="恢复" Style="{StaticResource GhostButton}" Padding="12,6"
                                                    ToolTip="把这个快照覆盖回当前实例"
                                                    Command="{Binding DataContext.RestoreSnapshotCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除" Style="{StaticResource GhostButton}" Padding="12,6"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteSnapshotCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态 -->
                    <TextBlock Text="这个实例还没有快照。点上面的「创建快照」先存一份。"
                               FontSize="10.5" Foreground="{DynamicResource Faint}" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Snapshots.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 说明 -->
            <TextBlock FontSize="10" Foreground="{DynamicResource Faint}" TextWrapping="Wrap"
                       Margin="0,10,0,0" LineHeight="17">
                <Run Text="· 快照只覆盖 saves / config / options.txt，不含 mods 与资源包，所以通常只有几十 MB。" />
                <LineBreak />
                <Run Text="· 快照按实例隔离：切到别的版本时这里只显示那个版本的快照。" />
                <LineBreak />
                <Run Text="· 恢复前会自动生成一份「恢复前保护快照」，误操作也能退回去。" />
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</UserControl>
