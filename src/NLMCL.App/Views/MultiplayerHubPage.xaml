<UserControl x:Class="NLMCL.App.Views.MultiplayerHubPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NLMCL.App.Views"
             FontFamily="{DynamicResource UiFont}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NLMCL;component/Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ModeTab" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoft}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HubModeCard" TargetType="Button">
                <Setter Property="Background" Value="#F7ECD9" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource Card}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                             Value="active">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource Card}" />
                                    <Setter TargetName="Bd" Property="BorderBrush"
                                            Value="{DynamicResource FrameRed}" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                    <Setter Property="Foreground" Value="{DynamicResource FrameRed}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="26,18,26,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="MULTIPLAYER / LAN + DIRECT" FontSize="9"
                       Foreground="{DynamicResource Faint}" />
            <Grid Margin="0,1,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="联机" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="ROOMS &amp; SERVERS" FontSize="10"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource Faint}"
                               VerticalAlignment="Bottom" Margin="8,0,0,4" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="10" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="11" Foreground="{DynamicResource FrameRed}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="点击卡片切换模式" FontSize="10"
                                   Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="服务器档案、局域网开房与扫描、地址二维码都在这里。连不上时先看检查项。"
                       FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"
                       TextWrapping="Wrap" />

            <Border Margin="0,12,0,0" Padding="4"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ServersTab" Grid.Column="0"
                            Style="{StaticResource HubModeCard}" Tag="active"
                            Click="ServersTab_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="8"
                                    Background="{DynamicResource PrimarySoft}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Foreground="{DynamicResource Primary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="服务器房间" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="收藏的服务器、开房与直连" FontSize="9.5"
                                           Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="LanTab" Grid.Column="1"
                            Style="{StaticResource HubModeCard}" Click="LanTab_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="8"
                                    Background="{DynamicResource AmberBg}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Foreground="{DynamicResource Amber}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="局域网扫描" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="发现同一网段的房间" FontSize="9.5"
                                           Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <views:MultiplayerPage x:Name="ServersView" />
            <views:LanScanPage x:Name="LanView" DataContext="{Binding LanScan}" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
