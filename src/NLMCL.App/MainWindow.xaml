<Window x:Class="NLMCL.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        xmlns:local="clr-namespace:NLMCL.App"
        xmlns:views="clr-namespace:NLMCL.App.Views"
        Title="{Binding ProductName}"
        Height="780" Width="1180"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource UiFont}"
        Background="{DynamicResource Bg}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanConverter x:Key="InverseBool" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <local:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
        <local:DirectoryNameConverter x:Key="DirectoryName" />

        <!-- 侧栏导航项 -->
        <DataTemplate x:Key="NavItemTemplate">
            <Button Style="{StaticResource NavButton}"
                    Command="{Binding DataContext.SelectSectionCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" FontSize="9.5" Opacity="0.62"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- 版本卡片：整行可点，点中即成为启动目标 -->
        <DataTemplate x:Key="VersionRowTemplate">
            <Button Style="{StaticResource RowButton}"
                    Command="{Binding DataContext.SelectVersionCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
            <Border Padding="14,12" Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
                                <Setter Property="Background" Value="{DynamicResource PrimarySoft}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 类型图标块 -->
                    <!-- 加载器徽标 -->
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="9"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding LoaderBadgeText}" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding LoaderLabel}" FontSize="7"
                                       Foreground="{DynamicResource Muted}" Margin="0,1,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource PrimarySoft}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Snapshot">
                                        <Setter Property="Background" Value="{DynamicResource SnapshotBg}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="OldBeta">
                                        <Setter Property="Background" Value="{DynamicResource OldBg}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="OldAlpha">
                                        <Setter Property="Background" Value="{DynamicResource OldBg}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- 名称 / 日期 / 告警 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding ReleasedLabel}" FontSize="10.5"
                                       Foreground="{DynamicResource Muted}" />
                            <TextBlock Text="{Binding BasedOn}" FontSize="10.5"
                                       Foreground="{DynamicResource Faint}" Margin="10,0,0,0"
                                       Visibility="{Binding HasBasedOn, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Warning}" FontSize="10.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Amber}"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding DirectoryLabel}" FontSize="9.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Faint}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DirectoryLabel}"
                                   Visibility="{Binding ShowDirectory, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- 类型徽章 -->
                    <Border Grid.Column="2" Margin="10,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Snapshot">
                                        <Setter Property="Background" Value="{DynamicResource SnapshotBg}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="OldBeta">
                                        <Setter Property="Background" Value="{DynamicResource OldBg}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="OldAlpha">
                                        <Setter Property="Background" Value="{DynamicResource OldBg}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding KindLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Snapshot">
                                            <Setter Property="Foreground" Value="{DynamicResource Snapshot}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="OldBeta">
                                            <Setter Property="Foreground" Value="{DynamicResource Old}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="OldAlpha">
                                            <Setter Property="Foreground" Value="{DynamicResource Old}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Button Grid.Column="3" Content="›" FontSize="17"
                            Style="{StaticResource GhostButton}"
                            Padding="8,0" MinWidth="28" Focusable="False"
                            ToolTip="查看版本详情"
                            Command="{Binding DataContext.ShowVersionDetailsCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
            </Button>
        </DataTemplate>
        <!-- F 顶部导航按钮 -->
        <Style x:Key="TopNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FrameMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6B1010" />
                                <Setter Property="Foreground" Value="{DynamicResource FrameText}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6B1010" />
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource FrameYellow}" />
                                <Setter Property="Foreground" Value="{DynamicResource FrameYellow}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroGhostButton" TargetType="Button">
            <Setter Property="Background" Value="#3D6350" />
            <Setter Property="Foreground" Value="#F8F3E4" />
            <Setter Property="BorderBrush" Value="#6F8A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A6B56" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TopNavItemTemplate">            <Button Style="{StaticResource TopNavButton}"
                    Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Description}">
                <TextBlock Text="{Binding Title}"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
            </Button>
        </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= F 顶部品牌 / 账号 ================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Card}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#600000">
                        <TextBlock Text="N" FontSize="20" FontWeight="Bold"
                                   Foreground="#F8D818"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource Text}" />
                        <TextBlock Text="像素世界库 · 本地优先" FontSize="10"
                                   Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,18,0">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Primary}" Margin="0,0,6,0" />
                    <TextBlock Text="本地服务在线 · 离线可用" FontSize="10"
                               Foreground="{DynamicResource Muted}" />
                </StackPanel>
                <Border Grid.Column="2" Height="52" MinWidth="196" Background="{DynamicResource Card}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="9"
                        Padding="7,0,13,0" Cursor="Hand" MouseLeftButtonUp="AccountCardClicked">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                Background="{DynamicResource Primary}">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,38,38" RadiusX="19" RadiusY="19" />
                            </Border.Clip>
                            <Grid>
                                <TextBlock Text="?" FontSize="15" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding AvatarPath}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AccountName}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock Text="{Binding AccountType}" FontSize="9.5"
                                       Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontSize="16"
                                   Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= F 顶部导航 ================= -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource FrameRed}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Background="Transparent">
                <ItemsControl ItemsSource="{Binding NavigationGroups}" VerticalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="1" Background="#7A2020" Margin="8,12" />
                                <TextBlock Text="{Binding Caption}" FontSize="9"
                                           Foreground="{DynamicResource FrameMuted}" VerticalAlignment="Center"
                                           Margin="4,0,6,0" />
                                <ItemsControl ItemsSource="{Binding Items}"
                                              ItemTemplate="{StaticResource TopNavItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ================= 旧侧栏（保留代码，F 布局下隐藏） ================= -->
        <Border Grid.Row="2" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource SidebarBg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,20,18,12">
                    <Border Width="40" Height="40" CornerRadius="9" Background="{DynamicResource SidebarLogoBg}">
                        <TextBlock Text="N" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Primary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource SidebarText}" />
                        <TextBlock Text="{Binding ProductTagline}" FontSize="9.5"
                                   Foreground="{DynamicResource SidebarMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 账号卡 -->
                <Border Grid.Row="1" Background="{DynamicResource SidebarAccountBg}" CornerRadius="9" Margin="12,0,12,6"
                        Padding="10,8" Cursor="Hand"
                        MouseLeftButtonUp="AccountCardClicked">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                Background="{DynamicResource Primary}">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,28,28" RadiusX="14" RadiusY="14" />
                            </Border.Clip>
                            <Grid>
                                <TextBlock Text="?" FontSize="12" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding AvatarPath}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AccountName}" FontSize="12"
                                       Foreground="{DynamicResource SidebarText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AccountType}" FontSize="9.5"
                                       Foreground="{DynamicResource SidebarMuted}" Margin="0,1,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontSize="15"
                                   Foreground="{DynamicResource SidebarMuted}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 分组导航 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              Background="Transparent" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SidebarScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding NavigationGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource NavGroupCaption}" />
                                    <ItemsControl ItemsSource="{Binding Items}"
                                                  ItemTemplate="{StaticResource NavItemTemplate}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 页脚 -->
                <StackPanel Grid.Row="3" Margin="20,10,20,16">
                    <TextBlock Text="{Binding StageLabel}" FontSize="9.5"
                               Foreground="{DynamicResource SidebarMuted}" />
                    <TextBlock Text="{Binding StageHint}" FontSize="9" Margin="0,3,0,0"
                               Foreground="{DynamicResource SidebarFaint}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主区域 ================= -->
        <Grid Grid.Row="2" Grid.Column="1">
            <!-- 版本页 -->
            <Grid Margin="26,22,26,14"
                  Visibility="{Binding IsVersionsSection, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- F 当前世界 Hero -->
            <Border Grid.Row="0" CornerRadius="12" Padding="22,18" Margin="0,0,0,2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#355B45" Offset="0" />
                        <GradientStop Color="#233D2E" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CURRENT WORLD / 本地实例" FontSize="9"
                                   Foreground="#CDE7C7" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding SelectedVersion.Name, TargetNullValue=未选择实例}"
                                       FontSize="28" FontWeight="Bold" Foreground="White" />
                            <Border Background="#F8D818" CornerRadius="4" Padding="7,3" Margin="10,5,0,0"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding SelectedVersion.KindLabel, TargetNullValue=本地}"
                                           FontSize="9" FontWeight="SemiBold" Foreground="#503A00" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding SelectedVersion.ReleasedLabel, TargetNullValue=尚未选择版本}"
                                       FontSize="10.5" Foreground="#C7D9C6" />
                            <TextBlock Text="  ·  " FontSize="10.5" Foreground="#849C86" />
                            <TextBlock Text="{Binding VersionCountLabel}" FontSize="10.5" Foreground="#C7D9C6" />
                            <TextBlock Text="  ·  " FontSize="10.5" Foreground="#849C86" />
                            <TextBlock Text="本地 · 离线可用" FontSize="10.5" Foreground="#C7D9C6" />
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentGameDirectory}" FontSize="9"
                                   FontFamily="Cascadia Mono, Consolas" Foreground="#90AE97"
                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxWidth="620" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="▶  启动游戏" Style="{StaticResource PrimaryButton}"
                                    Padding="18,9" Command="{Binding LaunchSelectedCommand}"
                                    IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}" />
                            <Button Content="打开目录" Style="{StaticResource HeroGhostButton}"
                                    Margin="7,0,0,0" Command="{Binding OpenGameDirectoryCommand}" />
                            <Button Content="修复" Style="{StaticResource HeroGhostButton}"
                                    Margin="7,0,0,0" Command="{Binding RepairSelectedCommand}" />
                            <Button Content="快照" Style="{StaticResource HeroGhostButton}"
                                    Margin="7,0,0,0" Command="{Binding GoToSnapshotsCommand}" />
                            <Button Content="重新扫描" Style="{StaticResource HeroGhostButton}"
                                    Margin="7,0,0,0" Command="{Binding RescanCommand}" />
                            <Button Content="重启" Style="{StaticResource HeroGhostButton}"
                                    Margin="7,0,0,0" Command="{Binding RestartGameCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.MinecraftVersion, TargetNullValue=LOCAL}"
                               FontSize="64" FontWeight="Bold" Foreground="#1AFFFFFF"
                               VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,4,-8" />
                </Grid>
            </Border>
            <!-- 游戏目录 -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,18,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="游戏目录" FontSize="11"
                               Foreground="{DynamicResource Muted}" />
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="7" Padding="10,7">
                            <TextBox Text="{Binding CurrentGameDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="11.5"
                                     Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                        </Border>
                        <Button Grid.Column="1" Content="📁" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Padding="10,7"
                                ToolTip="选择 .minecraft 文件夹"
                                Command="{Binding PickGameDirectoryCommand}" />
                        <Button Grid.Column="2" Content="⟳  扫描版本" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Padding="14,7"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding GameDirectories}"
                                  SelectedItem="{Binding SelectedGameDirectory, Mode=TwoWay}"
                                  FontSize="10.5" Padding="8,5"
                                  MaxDropDownHeight="260"
                                  Background="{DynamicResource Surface}"
                                  Foreground="{DynamicResource Text}"
                                  ToolTip="已添加的游戏目录；扫描会遍历全部目录">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2" MaxWidth="420">
                                        <TextBlock Text="{Binding Converter={StaticResource DirectoryName}}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource Text}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding}" FontSize="8.5"
                                                   Foreground="{DynamicResource Faint}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1" Content="添加文件夹…" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Padding="10,5" FontSize="10"
                                ToolTip="打开文件夹选择器，把 .minecraft 目录加入列表"
                                Command="{Binding AddGameDirectoryCommand}" />
                        <Button Grid.Column="2" Content="扫描全盘" Style="{StaticResource GhostButton}"
                                Margin="6,0,0,0" Padding="10,5" FontSize="10"
                                ToolTip="扫描整台电脑，自动加入所有 .minecraft 目录"
                                Command="{Binding ScanAllGameDirectoriesCommand}"
                                IsEnabled="{Binding IsScanningDirectories, Converter={StaticResource InverseBool}}" />
                        <Button Grid.Column="3" Content="移除" Style="{StaticResource GhostButton}"
                                Margin="6,0,0,0" Padding="10,5" FontSize="10"
                                ToolTip="从列表移除当前目录（至少保留一个）"
                                Command="{Binding RemoveGameDirectoryCommand}" />
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0"
                                Visibility="{Binding IsScanningDirectories, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Height="4" IsIndeterminate="True"
                                     Foreground="{DynamicResource Primary}"
                                     Background="{DynamicResource Surface}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ScanProgressText}"
                                       FontSize="9.5" Foreground="{DynamicResource Muted}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="停止扫描"
                                    Style="{StaticResource GhostButton}"
                                    Margin="10,0,0,0" Padding="10,3" FontSize="9.5"
                                    Command="{Binding StopScanAllGameDirectoriesCommand}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 汇总行 -->
            <Grid Grid.Row="2" Margin="2,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding VersionCountLabel}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                            Visibility="{Binding HasRelease, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ReleaseCountLabel}" Style="{StaticResource ChipText}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Background="{DynamicResource SnapshotBg}" Margin="6,0,0,0"
                            Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SnapshotCountLabel}" Style="{StaticResource ChipText}"
                                   Foreground="{DynamicResource Snapshot}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Background="{DynamicResource OldBg}" Margin="6,0,0,0"
                            Visibility="{Binding HasOther, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding OtherCountLabel}" Style="{StaticResource ChipText}"
                                   Foreground="{DynamicResource Old}" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="时间倒序" FontSize="10"
                           Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
            </Grid>

            <!-- 列表 / 空状态 -->
            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Versions}"
                                  ItemTemplate="{StaticResource VersionRowTemplate}" />
                </ScrollViewer>

                <Border Style="{StaticResource CardStyle}" Padding="28"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="没有找到可用的游戏版本" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" HorizontalAlignment="Center" />
                        <TextBlock Text="请确认 .minecraft 路径正确，或先安装一个版本。"
                                   FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="这个目录下没有已安装的版本。"
                                   FontSize="10.5" Foreground="{DynamicResource Faint}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 选中实例的启动设置 -->
            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,6"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="内存 (MB)" FontSize="10.5"
                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{DynamicResource Surface}" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="6" Padding="8,4">
                        <TextBox Text="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="11"
                                 Foreground="{DynamicResource Text}" />
                    </Border>

                    <TextBlock Grid.Column="2" Text="Java" FontSize="10.5" Margin="14,0,0,0"
                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <Border Grid.Column="3" Background="{DynamicResource Surface}" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="6" Padding="8,4">
                        <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="11"
                                 Foreground="{DynamicResource Text}" />
                    </Border>

                    <TextBlock Grid.Column="4" Text="额外参数" FontSize="10.5" Margin="14,0,0,0"
                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <Border Grid.Column="5" Background="{DynamicResource Surface}" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="6" Padding="8,4">
                        <TextBox Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="11"
                                 Foreground="{DynamicResource Text}" />
                    </Border>

                <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button Content="重命名" Style="{StaticResource GhostButton}" Padding="10,4"
                            ToolTip="改实例目录名与 JSON id"
                            Command="{Binding RenameVersionCommand}" />
                    <Button Content="复制" Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0"
                            ToolTip="复制出一个新实例"
                            Command="{Binding CopyVersionCommand}" />
                    <Button Content="删除" Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0"
                            ToolTip="删除整个实例目录（带确认）"
                            Command="{Binding DeleteVersionCommand}" />
                </StackPanel>
                    <Button Grid.Column="7" Content="保存" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Padding="12,4"
                            Command="{Binding SaveSettingsCommand}" />

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="8" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="窗口" FontSize="10.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />

                        <Border Background="{DynamicResource Surface}" Margin="8,0,0,0" Width="70"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="6" Padding="8,4">
                            <TextBox Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="11"
                                     Foreground="{DynamicResource Text}"
                                     ToolTip="窗口宽度（0 = 游戏默认）" />
                        </Border>

                        <TextBlock Text="×" FontSize="10.5" Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" Margin="6,0" />

                        <Border Background="{DynamicResource Surface}" Width="70"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="6" Padding="8,4">
                            <TextBox Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="11"
                                     Foreground="{DynamicResource Text}"
                                     ToolTip="窗口高度（0 = 游戏默认）" />
                        </Border>

                        <CheckBox Content="全屏启动" IsChecked="{Binding Fullscreen}"
                                  Margin="14,0,0,0" VerticalAlignment="Center"
                                  Foreground="{DynamicResource Text}" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>

            </Grid>

            <!-- 设置页 -->
            <Grid Margin="26,22,26,14"
                  Visibility="{Binding IsSettingsSection, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="设置" FontSize="9.5" Foreground="{DynamicResource Faint}" />
                        <TextBlock Text="外观与运行" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource Text}" Margin="0,2,0,0" />
                        <TextBlock Text="默认值与运行环境；生效时机见各项说明"
                                   FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" />

                        <views:SettingsPage x:Name="SettingsView" Margin="0,18,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <!-- 导入资源页 -->
            <views:ResourcePage Margin="26,22,26,14"
                                DataContext="{Binding Resource}"
                                Visibility="{Binding DataContext.IsImportSection,
                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                     Converter={StaticResource BoolToVisibility}}" />
            <!-- 局域网扫描页 -->
            <views:LanScanPage Margin="26,22,26,14"
                               DataContext="{Binding LanScan}"
                               Visibility="{Binding DataContext.IsLanScanSection,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolToVisibility}}" />
            <!-- Mod 管理页 -->
            <views:ModPage Margin="26,22,26,14"
                           DataContext="{Binding Mods}"
                           Visibility="{Binding DataContext.IsModsSection,
                                                RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource BoolToVisibility}}" />
            <!-- 皮肤页 -->
            <views:SkinPage Margin="26,22,26,14"
                            DataContext="{Binding Skin}"
                            Visibility="{Binding DataContext.IsSkinSection,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVisibility}}" />
            <!-- 联机房间页 -->
            <views:MultiplayerPage Margin="26,22,26,14"
                                   Visibility="{Binding IsMultiplayerSection,
                                                        Converter={StaticResource BoolToVisibility}}" />

            <!-- 启动与日志页 -->
            <!-- 实例快照页 -->
            <views:SnapshotPage Margin="26,22,26,14"
                                  Visibility="{Binding IsSnapshotSection, Converter={StaticResource BoolToVisibility}}" />

            <views:LaunchConsolePage Margin="26,22,26,14"
                                     DataContext="{Binding Console}"
                                     Visibility="{Binding DataContext.IsLaunchSection,
                                                          RelativeSource={RelativeSource AncestorType=Window},
                                                          Converter={StaticResource BoolToVisibility}}" />
            <!-- 下载页 -->
            <views:DownloadPage Margin="26,22,26,14"
                                DataContext="{Binding Download}"
                                Visibility="{Binding DataContext.IsDownloadSection,
                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                     Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <!-- 版本详情 -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="999" Background="#66000000"
              MouseLeftButtonDown="VersionDetailsOverlayClicked"
              Visibility="{Binding IsVersionDetailsOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="620" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Card}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Padding="18,16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding VersionDetailsTitle}" FontSize="15"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                            <TextBlock Text="{Binding VersionDetailsSubtitle}" FontSize="9.5"
                                       Foreground="{DynamicResource Faint}" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource GhostButton}" Padding="9,1" FontSize="11"
                                Click="CloseVersionDetailsOverlay" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top"
                               Text="只读信息；不会修改版本文件或启动游戏。"
                               FontSize="9.5" Foreground="{DynamicResource Faint}"
                               Margin="0,0,0,10" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VersionDetailsLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="10"
                                                   Foreground="{DynamicResource Muted}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10.5"
                                                   Foreground="{DynamicResource Text}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 实例快照 -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="998" Background="#66000000"
              MouseLeftButtonDown="SnapshotOverlayClicked"
              Visibility="{Binding IsSnapshotPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="480" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Card}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Padding="16,14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="实例快照" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource GhostButton}" Padding="9,1" FontSize="11"
                                Click="CloseSnapshotOverlay" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top"
                               Text="备份 存档 / config / options.txt。回滚前会自动再存一份当前状态，不会丢东西。"
                               FontSize="9.5" Foreground="{DynamicResource Faint}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="6" Padding="8,4" Width="250">
                            <Grid>
                                <TextBlock Text="备注（例如：装 mod 前）" FontSize="10.5" Margin="1,0,0,0"
                                           Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                           Visibility="{Binding SnapshotNote, Converter={StaticResource EmptyToVisibility}}" />
                                <TextBox Text="{Binding SnapshotNote, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" FontSize="10.5"
                                         Foreground="{DynamicResource Text}" />
                            </Grid>
                        </Border>
                        <Button Content="新建快照" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Padding="14,7" Command="{Binding CreateSnapshotCommand}"
                                IsEnabled="{Binding IsSnapshotBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Snapshots}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" FontSize="9.5"
                                                       Foreground="{DynamicResource Faint}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="恢复" Style="{StaticResource GhostButton}"
                                                    Padding="10,4" FontSize="10"
                                                    Command="{Binding DataContext.RestoreSnapshotCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除" Style="{StaticResource GhostButton}"
                                                    Padding="10,4" FontSize="10" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteSnapshotCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <!-- 账号弹层：窗口内遮罩 + 居中卡片，内容可滚动 -->
        <!-- 原来是贴着账号卡片往下弹的 Popup，内容一多就顶出窗口底部，必须拖窗口才能点到。 -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="999" Background="#66000000"
              MouseLeftButtonDown="AccountOverlayClicked"
              Visibility="{Binding IsAccountPopupOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="420" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Card}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Padding="16,14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="登录账号" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource GhostButton}" Padding="9,1" FontSize="11"
                                Click="CloseAccountOverlay" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <!-- 已保存账号：一键切换 / 移除 -->
                            <ItemsControl ItemsSource="{Binding SavedAccounts}" Margin="0,0,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                CornerRadius="7" Padding="8,7" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 账号头像：正版拉官方皮肤头，离线用本地保存的皮肤头 -->
                                                <Border Grid.Column="0" Width="32" Height="32"
                                                        CornerRadius="16"
                                                        Background="{DynamicResource Primary}">
                                                    <Border.Clip>
                                                        <RectangleGeometry Rect="0,0,32,32" RadiusX="16" RadiusY="16" />
                                                    </Border.Clip>
                                                    <Grid>
                                                        <TextBlock Text="?" FontSize="13" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding AvatarPath}" Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                               Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                                   Foreground="{DynamicResource Text}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Border Background="{DynamicResource PrimarySoft}" CornerRadius="4"
                                                                Padding="5,1" Margin="6,0,0,0"
                                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="当前" FontSize="8.5"
                                                                       Foreground="{DynamicResource Primary}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="9.5"
                                                               Foreground="{DynamicResource Faint}" Margin="0,1,0,0" />
                                                    <TextBlock Text="{Binding LastUsedLabel}" FontSize="9"
                                                               Foreground="{DynamicResource Faint}" Margin="0,1,0,0" />
                                                </StackPanel>

                                                <Button Grid.Column="2" Content="切换"
                                                        Style="{StaticResource GhostButton}" Padding="10,3" FontSize="10.5"
                                                        IsEnabled="{Binding IsCurrent, Converter={StaticResource InverseBool}}"
                                                        Command="{Binding DataContext.SwitchAccountCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Account}" />
                                                <Button Grid.Column="3" Content="×"
                                                        Style="{StaticResource GhostButton}" Padding="8,3" FontSize="10.5"
                                                        Margin="6,0,0,0" ToolTip="移除这个账号"
                                                        Command="{Binding DataContext.RemoveAccountCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Account}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="离线登录" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock Text="名字决定离线 UUID"
                                       FontSize="9.5" Foreground="{DynamicResource Faint}"
                                       Margin="0,3,0,8" TextWrapping="Wrap" />
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,5">
                                <Grid>
                                    <TextBlock Text="玩家名（离线）" FontSize="11.5" Margin="1,0,0,0"
                                               Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                               Visibility="{Binding PlayerNameInput, Converter={StaticResource EmptyToVisibility}}" />
                                    <TextBox Text="{Binding PlayerNameInput, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" FontSize="11.5"
                                             Foreground="{DynamicResource Text}" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button Content="离线登录" Style="{StaticResource PrimaryButton}"
                                        Padding="12,6" Command="{Binding SignInOfflineCommand}" />
                                <Button Content="微软登录" Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0" Padding="12,6"
                                        Command="{Binding MicrosoftSignInCommand}"
                                        IsEnabled="{Binding IsMicrosoftSigningIn, Converter={StaticResource InverseBool}}" />
                                <Button Content="退出" Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0" Command="{Binding SignOutCommand}" />
                            </StackPanel>

                            <!-- 设备码：让用户照着输入到浏览器 -->
                            <Border Background="{DynamicResource PrimarySoft}" CornerRadius="6"
                                    Padding="8,6" Margin="0,8,0,0"
                                    Visibility="{Binding IsMicrosoftSigningIn, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="在浏览器里输入这个码" FontSize="9.5"
                                               Foreground="{DynamicResource Muted}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding DeviceCodeText}" FontSize="17"
                                                   FontWeight="Bold" Foreground="{DynamicResource Primary}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="复制" Style="{StaticResource GhostButton}"
                                                Margin="10,0,0,0" Padding="10,3" FontSize="10"
                                                Command="{Binding CopyDeviceCodeCommand}" />
                                        <Button Content="重新打开网页" Style="{StaticResource GhostButton}"
                                                Margin="6,0,0,0" Padding="10,3" FontSize="10"
                                                ToolTip="浏览器被关掉或没自动弹出时用"
                                                Command="{Binding ReopenDeviceCodePageCommand}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding DeviceCodeHint}" FontSize="9"
                                               Foreground="{DynamicResource Faint}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <!-- 微软登录的 Azure 应用 ID -->
                            <Border Background="{DynamicResource BorderColor}" Height="1" Margin="0,12,0,10" />
                            <TextBlock Text="微软登录需要 Azure 应用 ID（client id）"
                                       FontSize="9.5" Foreground="{DynamicResource Faint}"
                                       Margin="0,0,0,4" TextWrapping="Wrap" />
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,5">
                                <Grid>
                                    <TextBlock Text="Azure 应用 (客户端) ID" FontSize="10.5" Margin="1,0,0,0"
                                               Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                               Visibility="{Binding MicrosoftClientId, Converter={StaticResource EmptyToVisibility}}" />
                                    <TextBox Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" FontSize="10.5"
                                             Foreground="{DynamicResource Text}" />
                                </Grid>
                            </Border>

                            <!-- 外置登录：MUA 联合认证 / Blessing Skin 皮肤站 -->
                            <Border Background="{DynamicResource BorderColor}" Height="1" Margin="0,12,0,10" />
                            <TextBlock Text="外置登录（MUA 联合认证 / 皮肤站）"
                                       FontSize="9.5" Foreground="{DynamicResource Faint}"
                                       Margin="0,0,0,4" TextWrapping="Wrap" />
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <TextBlock Text="认证服务器地址（Yggdrasil）" FontSize="10" Margin="1,0,0,0"
                                               Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                               Visibility="{Binding ExternalServer, Converter={StaticResource EmptyToVisibility}}" />
                                    <TextBox Text="{Binding ExternalServer, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" FontSize="10"
                                             Foreground="{DynamicResource Text}" />
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource Surface}" Margin="0,4,0,0"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <TextBlock Text="账号（邮箱或用户名）" FontSize="10.5" Margin="1,0,0,0"
                                               Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                               Visibility="{Binding ExternalUserName, Converter={StaticResource EmptyToVisibility}}" />
                                    <TextBox Text="{Binding ExternalUserName, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" FontSize="10.5"
                                             Foreground="{DynamicResource Text}" />
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource Surface}" Margin="0,4,0,0"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <TextBlock Text="密码" FontSize="10.5" Margin="1,0,0,0"
                                               Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                               Visibility="{Binding ExternalPassword, Converter={StaticResource EmptyToVisibility}}" />
                                    <PasswordBox x:Name="ExternalPasswordBox"
                                                 PasswordChanged="ExternalPasswordChanged"
                                                 Background="Transparent" BorderThickness="0" FontSize="10.5"
                                                 Foreground="{DynamicResource Text}" />
                                </Grid>
                            </Border>
                            <Button Content="外置登录" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,8,0,2" Padding="12,6"
                                    Command="{Binding ExternalSignInCommand}"
                                    IsEnabled="{Binding IsExternalSigningIn, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== 状态提示（左下角滑入，几秒后自动淡出） ===== -->
        <Border x:Name="StatusToast" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="272,0,0,22" Padding="14,9" MaxWidth="560"
                Background="{DynamicResource Card}" BorderThickness="1"
                BorderBrush="{DynamicResource BorderColor}" CornerRadius="8"
                Opacity="0" IsHitTestVisible="False"
                >
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" X="-48" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <Border Width="3" CornerRadius="2" Background="{DynamicResource Primary}" Margin="0,0,10,0" />
                <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource Text}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
