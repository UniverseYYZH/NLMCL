<Window x:Class="NLMCL.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        xmlns:local="clr-namespace:NLMCL.App"
        xmlns:views="clr-namespace:NLMCL.App.Views"
        Title="{Binding ProductName}"
        Height="780" Width="1180"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13"
        Background="{DynamicResource Bg}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Design.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanConverter x:Key="InverseBool" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <local:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
        <local:DirectoryNameConverter x:Key="DirectoryName" />
        <local:PngBytesToImageSourceConverter x:Key="PngBytesToImage" />

        <!-- 侧栏导航项 -->
        <DataTemplate x:Key="NavItemTemplate">
            <Button Style="{StaticResource NavButton}"
                    Command="{Binding DataContext.SelectSectionCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" FontSize="9.5" Opacity="0.62"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- 版本卡片：整行可点，点中即成为启动目标 -->
        <DataTemplate x:Key="VersionRowTemplate">
            <Button Style="{StaticResource RowButton}"
                    Command="{Binding DataContext.SelectVersionCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    IsEnabled="{Binding DataContext.IsLaunching,
                                        RelativeSource={RelativeSource AncestorType=Window},
                                        Converter={StaticResource InverseBool}}">
            <Border Padding="11,9" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
                                <Setter Property="Background" Value="{DynamicResource PrimarySoft}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 类型图标块 -->
                    <!-- 加载器徽标 -->
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="9"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding LoaderBadgeText}" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding LoaderLabel}" FontSize="7"
                                       Foreground="{DynamicResource Muted}" Margin="0,1,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource PrimarySoft}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Snapshot">
                                        <Setter Property="Background" Value="{DynamicResource SnapshotBg}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="OldBeta">
                                        <Setter Property="Background" Value="{DynamicResource OldBg}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="OldAlpha">
                                        <Setter Property="Background" Value="{DynamicResource OldBg}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- 名称 / 元信息：固定三行，告警收成徽章，避免撑高列表 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Margin="8,0,0,0" Padding="7,1"
                                    Background="{DynamicResource AmberBg}"
                                    BorderBrush="{DynamicResource AmberBorder}" BorderThickness="1"
                                    CornerRadius="7" VerticalAlignment="Center"
                                    ToolTip="{Binding Warning}"
                                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="需检查" FontSize="9.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Amber}" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding LastLaunchLabel}" FontSize="10.5"
                                       Foreground="{DynamicResource Muted}" />
                            <TextBlock Text="{Binding BasedOn}" FontSize="10.5"
                                       Foreground="{DynamicResource Faint}" Margin="10,0,0,0"
                                       Visibility="{Binding HasBasedOn, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding FolderName, StringFormat=versions/{0}}"
                                   FontSize="9.25" Margin="0,3,0,0"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{DynamicResource Faint}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DirectoryLabel}" />
                    </StackPanel>

                    <!-- 类型徽章 -->
                    <Border Grid.Column="2" Margin="10,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Snapshot">
                                        <Setter Property="Background" Value="{DynamicResource SnapshotBg}" />
                                        <Setter Property="BorderBrush" Value="#DEC58C" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="OldBeta">
                                        <Setter Property="Background" Value="{DynamicResource OldBg}" />
                                        <Setter Property="BorderBrush" Value="#CFC7B5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="OldAlpha">
                                        <Setter Property="Background" Value="{DynamicResource OldBg}" />
                                        <Setter Property="BorderBrush" Value="#CFC7B5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding KindLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Snapshot">
                                            <Setter Property="Foreground" Value="{DynamicResource Snapshot}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="OldBeta">
                                            <Setter Property="Foreground" Value="{DynamicResource Old}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="OldAlpha">
                                            <Setter Property="Foreground" Value="{DynamicResource Old}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Button Grid.Column="3" Style="{StaticResource RowButton}"
                            Width="24" Focusable="False" ToolTip="查看版本详情"
                            Command="{Binding DataContext.ShowVersionDetailsCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <TextBlock Text="›" FontSize="18" Foreground="{DynamicResource Faint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>
            </Button>
        </DataTemplate>
        <!-- F 顶部导航按钮 -->
        <Style x:Key="TopNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FrameMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border x:Name="Line" Height="3" VerticalAlignment="Bottom" Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6B1010" />
                                <Setter Property="Foreground" Value="{DynamicResource FrameText}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource FrameText}" />
                                <Setter TargetName="Bd" Property="Background" Value="#6B1010" />
                                <Setter Property="Foreground" Value="{DynamicResource FrameText}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6B1010" />
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource FrameYellow}" />
                                <Setter Property="Foreground" Value="{DynamicResource FrameYellow}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroGhostButton" TargetType="Button">
            <Setter Property="Background" Value="#F4ECD9" />
            <Setter Property="Foreground" Value="#2E4538" />
            <Setter Property="BorderBrush" Value="#D9C9AC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EADFC8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TopNavItemTemplate">            <Button Style="{StaticResource TopNavButton}"
                    Visibility="{Binding IsTopLevel, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Description}">
                <TextBlock Text="{Binding Title}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource FrameMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource FrameYellow}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
        </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= F 顶部品牌 / 账号 ================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Card}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="11" Background="#600000">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.16" Color="#3A0000" />
                        </Border.Effect>
                        <TextBlock Text="N" FontSize="21" FontWeight="Bold"
                                   Foreground="#F8D818"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource Text}" />
                        <TextBlock Text="像素世界库  ·  本地优先" FontSize="10.5"
                                   Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,16,0" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="8" Padding="9,5" ToolTip="离线可用">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Primary}" Margin="0,0,6,0" />
                        <TextBlock Text="本地可用" FontSize="10.5"
                                   Foreground="{DynamicResource Muted}" />
                        <TextBlock Text="{Binding Download.Queue.Summary}" FontSize="10.5"
                                   Foreground="{DynamicResource Amber}" Margin="10,0,0,0" />
                    </StackPanel>
                </Border>
                <Button Grid.Column="2" Height="50" MinWidth="204" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        Padding="7,0,13,0" Cursor="Hand" Click="AccountCardClicked"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="账号与切换"
                        AutomationProperties.HelpText="打开账号列表，切换或移除账号">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                Background="{DynamicResource Primary}">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,36,36" RadiusX="18" RadiusY="18" />
                            </Border.Clip>
                            <Grid>
                                <TextBlock Text="?" FontSize="15" Foreground="{DynamicResource OnPrimary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding AvatarPng, Converter={StaticResource PngBytesToImage}}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AccountName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock Text="{Binding AccountType}" FontSize="10"
                                       Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontSize="16"
                                   Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- ================= F 顶部导航 ================= -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                BorderBrush="#4A0000" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#560000" Offset="0" />
                    <GradientStop Color="#6B0A0A" Offset="0.55" />
                    <GradientStop Color="#500000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="26,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <ItemsControl ItemsSource="{Binding TopNavigation}" VerticalAlignment="Stretch"
                                  ItemTemplate="{StaticResource TopNavItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= 旧侧栏（保留代码，F 布局下隐藏） ================= -->
        

        <!-- ================= 主区域 ================= -->
        <Grid Grid.Row="2" Grid.Column="1">
            <!-- F 世界库 -->
            <Grid Margin="26,18,26,12"
                  Visibility="{Binding IsVersionsSection, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- F 页头：左侧标题，右侧只保留最高频动作 -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="WORLD LIBRARY  /  LOCAL FIRST" FontSize="9.5"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{DynamicResource Faint}" />
                        <TextBlock Text="今天去哪个世界？" FontSize="29" FontWeight="Bold"
                                   Foreground="{DynamicResource Text}" Margin="0,3,0,0" />
                        <TextBlock Text="选择一个本地实例继续；版本、模组、快照都只保存在这台电脑。"
                                   FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                                Margin="16,0,0,4">
                        <Button Content="扫描世界" Style="{StaticResource GhostButton}"
                                Padding="14,8" Command="{Binding RescanCommand}" />
                        <Button Content="▶  继续游戏" Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0" Command="{Binding LaunchSelectedCommand}"
                                IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Grid>

                <!-- 当前世界 Hero：浅色像素风景，信息面板放在左侧 -->
                <Border Grid.Row="1" CornerRadius="16" Margin="0,0,0,14"
                        BorderBrush="#D5E1CC" BorderThickness="1" ClipToBounds="True">
                    <Grid MinHeight="226">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#DFF0F7" Offset="0" />
                                <GradientStop Color="#F5F2DA" Offset="0.72" />
                                <GradientStop Color="#F8EFD7" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>

                        <!-- 太阳与云 -->
                        <Ellipse Width="86" Height="86" Fill="#F8D818" Opacity="0.9"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,24,42,0" IsHitTestVisible="False" />
                        <Border Width="92" Height="22" CornerRadius="11" Background="#C9FFFFFF"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,52,146,0" IsHitTestVisible="False" />
                        <Border Width="54" Height="18" CornerRadius="9" Background="#B8FFFFFF"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,82,230,0" IsHitTestVisible="False" />

                        <!-- 山丘、草地与方块树 -->
                        <Viewbox Width="470" Height="226" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Stretch="UniformToFill" IsHitTestVisible="False">
                            <Canvas Width="470" Height="226">
                                <Path Data="M0,178 L0,142 C64,108 126,102 184,132 C238,160 280,130 338,108 C390,88 438,108 470,132 L470,226 L0,226 Z"
                                      Fill="#9DC894" />
                                <Path Data="M0,198 L0,176 C78,150 158,160 224,182 C300,206 374,174 470,154 L470,226 L0,226 Z"
                                      Fill="#639B58" />
                                <Rectangle Canvas.Left="0" Canvas.Top="202" Width="470" Height="24" Fill="#9A7856" />
                                <Rectangle Canvas.Left="0" Canvas.Top="202" Width="470" Height="7" Fill="#5F9454" />
                                <!-- 树 -->
                                <Rectangle Canvas.Left="366" Canvas.Top="150" Width="13" Height="58" Fill="#745035" />
                                <Rectangle Canvas.Left="340" Canvas.Top="126" Width="66" Height="32" Fill="#3F7047" />
                                <Rectangle Canvas.Left="350" Canvas.Top="110" Width="46" Height="20" Fill="#4F8757" />
                                <Rectangle Canvas.Left="330" Canvas.Top="146" Width="30" Height="20" Fill="#3A6742" />
                                <Rectangle Canvas.Left="386" Canvas.Top="142" Width="30" Height="22" Fill="#477B4F" />
                                <!-- 草方块 / 小花 -->
                                <Rectangle Canvas.Left="52" Canvas.Top="188" Width="32" Height="30" Fill="#9B7552" />
                                <Rectangle Canvas.Left="52" Canvas.Top="188" Width="32" Height="9" Fill="#6DA05D" />
                                <Rectangle Canvas.Left="94" Canvas.Top="202" Width="18" Height="16" Fill="#B78A5E" />
                                <Rectangle Canvas.Left="94" Canvas.Top="202" Width="18" Height="5" Fill="#7FAE6D" />
                                <Ellipse Canvas.Left="132" Canvas.Top="192" Width="5" Height="5" Fill="#F3C94C" />
                                <Ellipse Canvas.Left="150" Canvas.Top="204" Width="4" Height="4" Fill="#FFFFFF" />
                                <Ellipse Canvas.Left="28" Canvas.Top="210" Width="4" Height="4" Fill="#F3C94C" />
                            </Canvas>
                        </Viewbox>

                        <!-- 信息面板 -->
                        <Border Margin="18" Padding="18,14" MaxWidth="566"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="#F4FFFCF3" BorderBrush="#D9E3D1" BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="CURRENT WORLD  /  本地实例" FontSize="9.5"
                                           FontFamily="Cascadia Mono, Consolas"
                                           Foreground="{DynamicResource Primary}" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SelectedVersion.Name, TargetNullValue=未选择实例}"
                                               FontSize="30" FontWeight="Bold"
                                               Foreground="{DynamicResource Text}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Background="{DynamicResource FrameYellow}"
                                            CornerRadius="7" Padding="8,3" Margin="10,5,0,0"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SelectedVersion.KindLabel, TargetNullValue=本地}"
                                                   FontSize="9.5" FontWeight="SemiBold" Foreground="#503A00" />
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding SelectedVersion.LastLaunchLabel, TargetNullValue=尚未选择版本}"
                                               FontSize="11" Foreground="{DynamicResource Muted}" />
                                    <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource Faint}" />
                                    <TextBlock Text="{Binding VersionCountLabel}" FontSize="11"
                                               Foreground="{DynamicResource Muted}" />
                                    <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource Faint}" />
                                    <TextBlock Text="本地 · 离线可用" FontSize="11"
                                               Foreground="{DynamicResource Muted}" />
                                </StackPanel>
                                <Border Background="#EAF1E3" CornerRadius="7" Padding="9,5"
                                        Margin="0,8,0,0" HorizontalAlignment="Left"
                                        ToolTip="{Binding CurrentGameDirectory}">
                                    <TextBlock Text="{Binding SelectedVersion.FolderName, StringFormat=versions/{0}, TargetNullValue=尚未选择实例}"
                                               FontSize="9.5" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{DynamicResource Primary}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="430" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="▶  启动游戏" Style="{StaticResource PrimaryButton}"
                                            Padding="18,9" Command="{Binding LaunchSelectedCommand}"
                                            IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}" />
                                    <Button Content="打开目录" Style="{StaticResource GhostButton}"
                                            Margin="7,0,0,0" Command="{Binding OpenGameDirectoryCommand}" />
                                    <Button Content="修复" Style="{StaticResource GhostButton}"
                                            Margin="7,0,0,0" Command="{Binding RepairSelectedCommand}"
                                            IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}" />
                                    <Button Content="快照" Style="{StaticResource GhostButton}"
                                            Margin="7,0,0,0" Command="{Binding GoToSnapshotsCommand}" />
                                    <Button Content="重启" Style="{StaticResource GhostButton}"
                                            Margin="7,0,0,0" Command="{Binding RestartGameCommand}"
                                            IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="318" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：我的世界库 -->
                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="2,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="我的世界库" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding VersionCountLabel}" FontSize="10.5"
                                           Foreground="{DynamicResource Muted}" Margin="9,2,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="刷新" Style="{StaticResource GhostButton}" Padding="10,4"
                                        FontSize="9.5" Command="{Binding RescanCommand}" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding Versions}"
                                     ItemTemplate="{StaticResource VersionRowTemplate}"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <Border Style="{StaticResource CardStyle}" Padding="28"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="没有找到可用的游戏版本" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}" HorizontalAlignment="Center" />
                                    <TextBlock Text="请确认 .minecraft 路径正确，或先安装一个版本。"
                                               FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 右：庭院侧栏 -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="下一次冒险" FontSize="9"
                                               Foreground="{DynamicResource Faint}" />
                                    <TextBlock Text="{Binding SelectedVersion.Name, TargetNullValue=尚未选择实例}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Primary}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SelectedVersion.LastLaunchLabel, TargetNullValue=选择左侧实例开始}"
                                               Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
                                    <UniformGrid Columns="3" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="JAVA" FontSize="7" Foreground="{DynamicResource Faint}" />
                                            <TextBlock Text="{Binding EffectiveJavaText}" FontSize="8.5"
                                                       Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding EffectiveJavaText}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="MEMORY" FontSize="7" Foreground="{DynamicResource Faint}" />
                                            <TextBlock Text="{Binding MemoryMb, StringFormat={}{0} MB}" FontSize="8.5"
                                                       Foreground="{DynamicResource Text}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="VERSIONS" FontSize="7" Foreground="{DynamicResource Faint}" />
                                            <TextBlock Text="{Binding VersionCountLabel}" FontSize="8.5"
                                                       Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="启动" Style="{StaticResource PrimaryButton}"
                                                Padding="14,6" FontSize="10.5" Command="{Binding LaunchSelectedCommand}"
                                                IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}" />
                                        <Button Content="详情" Style="{StaticResource GhostButton}"
                                                Padding="12,6" FontSize="10" Margin="6,0,0,0"
                                                Command="{Binding ShowVersionDetailsCommand}"
                                                CommandParameter="{Binding SelectedVersion}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,7,0,0">
                                <StackPanel>
                                    <TextBlock Text="世界动态" FontSize="9"
                                               Foreground="{DynamicResource Faint}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="10"
                                               Foreground="{DynamicResource Text}" Margin="0,6,0,0"
                                               TextWrapping="Wrap" />
                                    <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                                                 Foreground="{DynamicResource Primary}"
                                                 Background="{DynamicResource Surface}"
                                                 Visibility="{Binding IsScanningDirectories, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding ScanProgressText}" FontSize="8.5"
                                               Foreground="{DynamicResource Muted}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsScanningDirectories, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="停止扫描" Style="{StaticResource GhostButton}"
                                            Padding="10,4" FontSize="9" Margin="0,6,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding StopScanAllGameDirectoriesCommand}"
                                            Visibility="{Binding IsScanningDirectories, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,7,0,0">
                                <StackPanel>
                                    <TextBlock Text="游戏目录" FontSize="9"
                                               Foreground="{DynamicResource Faint}" />
                                    <ComboBox ItemsSource="{Binding GameDirectories}"
                                              SelectedItem="{Binding SelectedGameDirectory, Mode=TwoWay}"
                                              ToolTip="{Binding SelectedGameDirectory}"
                                              FontSize="10" Padding="7,4" Margin="0,6,0,0"
                                              Background="{DynamicResource Surface}"
                                              Foreground="{DynamicResource Text}"
                                              MaxDropDownHeight="240">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2" MaxWidth="250">
                                                    <TextBlock Text="{Binding Converter={StaticResource DirectoryName}}"
                                                               FontSize="10" Foreground="{DynamicResource Text}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding}" FontSize="8"
                                                               Foreground="{DynamicResource Faint}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <WrapPanel Margin="0,7,0,0">
                                        <Button Content="添加" Style="{StaticResource GhostButton}"
                                                Padding="8,4" FontSize="9" Command="{Binding AddGameDirectoryCommand}" />
                                        <Button Content="扫描全盘" Style="{StaticResource GhostButton}"
                                                Padding="8,4" FontSize="9" Margin="4,0,0,0"
                                                Command="{Binding ScanAllGameDirectoriesCommand}" />
                                        <Button Content="移除" Style="{StaticResource GhostButton}"
                                                Padding="8,4" FontSize="9" Margin="4,0,0,0"
                                                Command="{Binding RemoveGameDirectoryCommand}" />
                                        <Button Content="打开" Style="{StaticResource GhostButton}"
                                                Padding="8,4" FontSize="9" Margin="4,0,0,0"
                                                Command="{Binding OpenGameDirectoryCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Expander Header="启动设置 / 当前实例" Margin="0,7,0,0"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,5,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="内存 MB" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="10" Padding="6,4" Background="{DynamicResource Surface}"
                                                     Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource BorderColor}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Java" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="9" Padding="6,4" Background="{DynamicResource Surface}"
                                                     Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource BorderColor}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="额外参数" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="9" Padding="6,4" Background="{DynamicResource Surface}"
                                                     Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource BorderColor}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="62,0,0,6">
                                            <TextBox Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}" Width="54"
                                                     FontSize="9" Padding="4,4" Background="{DynamicResource Surface}"
                                                     Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource BorderColor}" />
                                            <TextBlock Text="×" Foreground="{DynamicResource Muted}" Margin="5,0" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}" Width="54"
                                                     FontSize="9" Padding="4,4" Background="{DynamicResource Surface}"
                                                     Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource BorderColor}" />
                                            <CheckBox Content="全屏" IsChecked="{Binding Fullscreen}" FontSize="9.5"
                                                      Foreground="{DynamicResource Text}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <CheckBox Content="使用代理" IsChecked="{Binding UseProxy}" FontSize="9.5"
                                                  Foreground="{DynamicResource Text}" Margin="62,0,0,4" />
                                        <Grid Margin="62,0,0,6" IsEnabled="{Binding UseProxy}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="9" Padding="6,4" Background="{DynamicResource Surface}"
                                                     Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource BorderColor}"
                                                     ToolTip="代理主机，例如 127.0.0.1" />
                                            <TextBox Grid.Column="1" Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="9" Padding="4,4" Margin="4,0,0,0" Background="{DynamicResource Surface}"
                                                     Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource BorderColor}"
                                                     ToolTip="代理端口，例如 7890" />
                                        </Grid>
                                        <CheckBox Content="软件 OpenGL 兼容（仅 LWJGL2 旧版本）"
                                                  IsChecked="{Binding SoftwareOpenGl}" FontSize="9.5"
                                                  Foreground="{DynamicResource Text}" Margin="62,0,0,6"
                                                  ToolTip="旧显卡或驱动异常时允许软件渲染回退；新版本会忽略该参数。" />
                                        <WrapPanel Margin="62,0,0,0">
                                            <Button Content="保存" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="9"
                                                    Command="{Binding SaveSettingsCommand}" />
                                            <Button Content="重命名" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="9" Margin="4,0,0,0"
                                                    Command="{Binding RenameVersionCommand}" />
                                            <Button Content="复制" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="9" Margin="4,0,0,0"
                                                    Command="{Binding CopyVersionCommand}" />
                                            <Button Content="删除" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="9" Margin="4,0,0,0"
                                                    Command="{Binding DeleteVersionCommand}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <!-- 世界实例详情 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsWorldSection, Converter={StaticResource BoolToVisibility}}">
                <views:WorldPage Margin="26,18,26,12" />
            </ScrollViewer>

            <!-- 设置页：页头由 SettingsPage 自己负责，避免重复 -->
            <views:SettingsPage x:Name="SettingsView" Margin="26,18,26,12"
                                Visibility="{Binding DataContext.IsSettingsSection,
                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                     Converter={StaticResource BoolToVisibility}}" />
            <!-- 导入资源页 -->
            
            <!-- Mod 管理页 -->
            
            <!-- 皮肤页 -->
            <views:SkinPage Margin="26,18,26,12"
                            DataContext="{Binding Skin}"
                            Visibility="{Binding DataContext.IsSkinSection,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVisibility}}" />
            <!-- 联机房间 / 局域网 -->
            <views:MultiplayerHubPage Margin="26,18,26,12"
                                      Visibility="{Binding IsMultiplayerSection,
                                                           Converter={StaticResource BoolToVisibility}}" />

            <!-- 方块宁理服务器 -->
            <views:NingliPage x:Name="NingliView" Margin="26,18,26,12"
                              Visibility="{Binding DataContext.IsNingliSection,
                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource BoolToVisibility}}" />

            <!-- 启动与日志页 -->
            <!-- 实例快照页 -->
            <views:SnapshotPage Margin="26,18,26,12"
                                  Visibility="{Binding IsSnapshotSection, Converter={StaticResource BoolToVisibility}}" />

            <views:LaunchConsolePage Margin="26,18,26,12"
                                     DataContext="{Binding Console}"
                                     Visibility="{Binding DataContext.IsLaunchSection,
                                                          RelativeSource={RelativeSource AncestorType=Window},
                                                          Converter={StaticResource BoolToVisibility}}" />
            <!-- 下载页 -->
            <views:DownloadHubPage x:Name="DownloadHub" Visibility="{Binding DataContext.IsDownloadSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <!-- 版本详情 -->
        <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="999" Background="#66000000"
              MouseLeftButtonDown="VersionDetailsOverlayClicked"
              Visibility="{Binding IsVersionDetailsOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="620" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Card}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Padding="18,16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding VersionDetailsTitle}" FontSize="15"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                            <TextBlock Text="{Binding VersionDetailsSubtitle}" FontSize="9.5"
                                       Foreground="{DynamicResource Faint}" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Content="✕" ToolTip="关闭" AutomationProperties.Name="关闭" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource GhostButton}" Padding="9,1" FontSize="11"
                                Click="CloseVersionDetailsOverlay" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top"
                               Text="只读信息；不会修改版本文件或启动游戏。"
                               FontSize="9.5" Foreground="{DynamicResource Faint}"
                               Margin="0,0,0,10" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VersionDetailsLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="10.5"
                                                   Foreground="{DynamicResource Muted}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5"
                                                   Foreground="{DynamicResource Text}"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 实例快照 -->
        <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="998" Background="#66000000"
              MouseLeftButtonDown="SnapshotOverlayClicked"
              Visibility="{Binding IsSnapshotPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="480" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Card}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Padding="16,14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="实例快照" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                        <Button Content="✕" ToolTip="关闭" AutomationProperties.Name="关闭" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource GhostButton}" Padding="9,1" FontSize="11"
                                Click="CloseSnapshotOverlay" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top"
                               Text="备份 存档 / config / options.txt。回滚前会自动再存一份当前状态，不会丢东西。"
                               FontSize="9.5" Foreground="{DynamicResource Faint}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="6" Padding="8,4" Width="250">
                            <Grid>
                                <TextBlock Text="备注（例如：装 mod 前）" FontSize="10.5" Margin="1,0,0,0"
                                           Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                           Visibility="{Binding SnapshotNote, Converter={StaticResource EmptyToVisibility}}" />
                                <TextBox Text="{Binding SnapshotNote, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" FontSize="10.5"
                                         Foreground="{DynamicResource Text}" />
                            </Grid>
                        </Border>
                        <Button Content="新建快照" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Padding="14,7" Command="{Binding CreateSnapshotCommand}"
                                IsEnabled="{Binding IsSnapshotBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Snapshots}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" FontSize="9.5"
                                                       Foreground="{DynamicResource Faint}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="恢复" Style="{StaticResource GhostButton}"
                                                    Padding="10,4" FontSize="10"
                                                    Command="{Binding DataContext.RestoreSnapshotCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除" Style="{StaticResource GhostButton}"
                                                    Padding="10,4" FontSize="10" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteSnapshotCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <!-- 账号弹层：窗口内遮罩 + 居中卡片，内容可滚动 -->
        <!-- 原来是贴着账号卡片往下弹的 Popup，内容一多就顶出窗口底部，必须拖窗口才能点到。 -->
        <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="999" Background="#66000000"
              MouseLeftButtonDown="AccountOverlayClicked"
              Visibility="{Binding IsAccountPopupOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="420" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Card}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Padding="16,14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="登录账号" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                        <Button Content="✕" ToolTip="关闭" AutomationProperties.Name="关闭" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource GhostButton}" Padding="9,1" FontSize="11"
                                Click="CloseAccountOverlay" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <!-- 已保存账号：一键切换 / 移除 -->
                            <ItemsControl ItemsSource="{Binding SavedAccounts}" Margin="0,0,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="8,6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="30" Height="30"
                                                        CornerRadius="15"
                                                        Background="{DynamicResource Primary}">
                                                    <Grid>
                                                        <TextBlock Text="?" FontSize="12"
                                                                   Foreground="{DynamicResource OnPrimary}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Image Source="{Binding AvatarPng, Converter={StaticResource PngBytesToImage}}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                               Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                </Border>
                                                <Button Grid.Column="1" Margin="8,0,4,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="0" HorizontalContentAlignment="Left"
                                                        Cursor="Hand" ToolTip="点击切换到该账号"
                                                        Click="SwitchAccountButton_Click">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Text}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="9.5"
                                                                   Foreground="{DynamicResource Muted}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <Border Grid.Column="2" Background="{DynamicResource PrimarySoft}"
                                                        CornerRadius="6" Padding="6,2" Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="当前" FontSize="9"
                                                               Foreground="{DynamicResource Primary}"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <Button Grid.Column="3" Content="切换"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="8,3" FontSize="10"
                                                        Margin="0,0,5,0"
                                                        Click="SwitchAccountButton_Click"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource InverseBoolToVisibility}}" />
                                                <Button Grid.Column="4" Content="移除"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="8,3" FontSize="10"
                                                        Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Account}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="离线登录" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock Text="名字决定离线 UUID"
                                       FontSize="9.5" Foreground="{DynamicResource Faint}"
                                       Margin="0,3,0,8" TextWrapping="Wrap" />
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,5">
                                <Grid>
                                    <TextBlock Text="玩家名（离线）" FontSize="11.5" Margin="1,0,0,0"
                                               Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                               Visibility="{Binding PlayerNameInput, Converter={StaticResource EmptyToVisibility}}" />
                                    <TextBox Text="{Binding PlayerNameInput, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" FontSize="11.5"
                                             Foreground="{DynamicResource Text}" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button Content="离线登录" Style="{StaticResource PrimaryButton}"
                                        Padding="12,6" Command="{Binding SignInOfflineCommand}" />
                                <Button Content="微软登录" Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0" Padding="12,6"
                                        Command="{Binding MicrosoftSignInCommand}"
                                        IsEnabled="{Binding IsMicrosoftSigningIn, Converter={StaticResource InverseBool}}" />
                                <Button Content="退出" Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0" Command="{Binding SignOutCommand}" />
                            </StackPanel>

                            <!-- 设备码：让用户照着输入到浏览器 -->
                            <Border Background="{DynamicResource PrimarySoft}" CornerRadius="6"
                                    Padding="8,6" Margin="0,8,0,0"
                                    Visibility="{Binding IsMicrosoftSigningIn, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="在浏览器里输入这个码" FontSize="9.5"
                                               Foreground="{DynamicResource Muted}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding DeviceCodeText}" FontSize="17"
                                                   FontWeight="Bold" Foreground="{DynamicResource Primary}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="复制" Style="{StaticResource GhostButton}"
                                                Margin="10,0,0,0" Padding="10,3" FontSize="10"
                                                Command="{Binding CopyDeviceCodeCommand}" />
                                        <Button Content="重新打开网页" Style="{StaticResource GhostButton}"
                                                Margin="6,0,0,0" Padding="10,3" FontSize="10"
                                                ToolTip="浏览器被关掉或没自动弹出时用"
                                                Command="{Binding ReopenDeviceCodePageCommand}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding DeviceCodeHint}" FontSize="9"
                                               Foreground="{DynamicResource Faint}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <!-- 微软登录的 Azure 应用 ID -->
                            <Border Background="{DynamicResource BorderColor}" Height="1" Margin="0,12,0,10" />
                            <TextBlock Text="微软登录需要 Azure 应用 ID（client id）"
                                       FontSize="9.5" Foreground="{DynamicResource Faint}"
                                       Margin="0,0,0,4" TextWrapping="Wrap" />
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,5">
                                <Grid>
                                    <TextBlock Text="Azure 应用 (客户端) ID" FontSize="10.5" Margin="1,0,0,0"
                                               Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                               Visibility="{Binding MicrosoftClientId, Converter={StaticResource EmptyToVisibility}}" />
                                    <TextBox Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" FontSize="10.5"
                                             Foreground="{DynamicResource Text}" />
                                </Grid>
                            </Border>

                            <!-- 外置登录：MUA 联合认证 / Blessing Skin 皮肤站 -->
                            <Border Background="{DynamicResource BorderColor}" Height="1" Margin="0,12,0,10" />
                            <TextBlock Text="外置登录（MUA 联合认证 / 皮肤站）"
                                       FontSize="9.5" Foreground="{DynamicResource Faint}"
                                       Margin="0,0,0,4" TextWrapping="Wrap" />
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <TextBlock Text="认证服务器地址（Yggdrasil）" FontSize="10" Margin="1,0,0,0"
                                               Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                               Visibility="{Binding ExternalServer, Converter={StaticResource EmptyToVisibility}}" />
                                    <TextBox Text="{Binding ExternalServer, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" FontSize="10"
                                             Foreground="{DynamicResource Text}" />
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource Surface}" Margin="0,4,0,0"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <TextBlock Text="账号（邮箱或用户名）" FontSize="10.5" Margin="1,0,0,0"
                                               Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                               Visibility="{Binding ExternalUserName, Converter={StaticResource EmptyToVisibility}}" />
                                    <TextBox Text="{Binding ExternalUserName, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" FontSize="10.5"
                                             Foreground="{DynamicResource Text}" />
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource Surface}" Margin="0,4,0,0"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <TextBlock Text="密码" FontSize="10.5" Margin="1,0,0,0"
                                               Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                               Visibility="{Binding ExternalPassword, Converter={StaticResource EmptyToVisibility}}" />
                                    <PasswordBox x:Name="ExternalPasswordBox"
                                                 PasswordChanged="ExternalPasswordChanged"
                                                 Background="Transparent" BorderThickness="0" FontSize="10.5"
                                                 Foreground="{DynamicResource Text}" />
                                </Grid>
                            </Border>
                            <Button Content="外置登录" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,8,0,2" Padding="12,6"
                                    Command="{Binding ExternalSignInCommand}"
                                    IsEnabled="{Binding IsExternalSigningIn, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== 状态提示（左下角滑入，几秒后自动淡出） ===== -->
        <!-- 邀请链接确认：确认前不启动游戏。 -->
        <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="1000" Background="#66000000"
              Visibility="{Binding IsInvitePromptOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Card}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Padding="22,20">
                <StackPanel>
                    <TextBlock Text="收到服务器邀请" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="确认后才会启动游戏并连接；取消不会改动任何设置。"
                               FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,14" />
                    <TextBlock Text="{Binding InviteServerName}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                    <Border Background="{DynamicResource Surface}" CornerRadius="7" Padding="10,8" Margin="0,8,0,0">
                        <TextBlock Text="{Binding InviteServerAddress}" FontSize="12"
                                   FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Text}" />
                    </Border>
                    <Border Background="{DynamicResource AmberBg}" CornerRadius="7" Padding="10,8" Margin="0,10,0,0"
                            Visibility="{Binding InviteRequiresAutoModpack, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="该邀请标记为模组服；如果本机没有对应实例，需要先准备 AutoModpack。"
                                   FontSize="10.5" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding InviteHint}" FontSize="10.5"
                               Foreground="{DynamicResource Faint}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="取消" Style="{StaticResource GhostButton}" Padding="16,7"
                                Command="{Binding CancelInviteCommand}" Margin="0,0,8,0" />
                        <Button Content="加入服务器" Style="{StaticResource PrimaryButton}" Padding="18,7"
                                Command="{Binding AcceptInviteCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="StatusToast" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="272,0,0,22" Padding="14,9" MaxWidth="560"
                Background="{DynamicResource Card}" BorderThickness="1"
                BorderBrush="{DynamicResource BorderColor}" CornerRadius="8"
                Opacity="0" IsHitTestVisible="False"
                >
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" X="-48" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <Border Width="3" CornerRadius="2" Background="{DynamicResource Primary}" Margin="0,0,10,0" />
                <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource Text}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
