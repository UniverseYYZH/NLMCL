<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- PCL 的 VB 代码依赖 Option Strict Off 的隐式转换，这里必须与上游一致 -->
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <RootNamespace></RootNamespace>
    <AssemblyName>NLCL.Core.Pcl.Vb</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- BC42025：上游用 `Settings.Sources.Instance` 通过实例访问嵌套类型，是 PCL 既有写法 -->
    <NoWarn>$(NoWarn);42025</NoWarn>
  </PropertyGroup>

  <!-- 项目级 Imports：与 PCL 的 .vbproj 保持一致（去掉我们拿不到的 MeloongCore.*） -->
  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="Newtonsoft.Json" />
    <Import Include="Newtonsoft.Json.Linq" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Concurrent" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.IO" />
    <Import Include="System.IO.Compression" />
    <Import Include="System.Linq" />
    <Import Include="System.Net" />
    <Import Include="System.Net.Http" />
    <Import Include="System.Text" />
    <Import Include="System.Threading" />
    <Import Include="System.Threading.Tasks" />
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Xml.Linq" />
    <Import Include="ThrottleDebounce" />
    <Import Include="MeloongCore" />
    <Import Include="MeloongCore.Extensions" />
    <Import Include="MeloongCore.Wpf" />
    <Import Include="MeloongCore.Wpf.Extensions" />
    <Import Include="PCLCS" />
  </ItemGroup>

  <!-- PCL 的 VB 模块直接引用 WPF 类型（Dispatcher / Application）。
       net48 上的 VB 类库可以引用 WPF 程序集，只是不能做 XAML 编译。 -->
  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- PCL 自带的第三方二进制，从 pcl_src/Resources 复制而来 -->
  <ItemGroup>
    <Reference Include="CacheCow.Client">
      <HintPath>lib\CacheCow.Client.dll</HintPath>
    </Reference>
    <Reference Include="CacheCow.Client.FileStore">
      <HintPath>lib\CacheCow.Client.FileStore.dll</HintPath>
    </Reference>
    <Reference Include="CacheCow.Common">
      <HintPath>lib\CacheCow.Common.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http.Formatting">
      <HintPath>lib\System.Net.Http.Formatting.dll</HintPath>
    </Reference>
    <Reference Include="ThrottleDebounce">
      <HintPath>lib\ThrottleDebounce.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NLCL.Abstractions\NLCL.Abstractions.csproj" />
    <ProjectReference Include="..\NLCL.Core.Pcl\NLCL.Core.Pcl.csproj" />
    <ProjectReference Include="..\..\third_party\MeloongCore\Shared\MeloongCore.csproj" />
    <ProjectReference Include="..\..\third_party\MeloongCore\Wpf\MeloongCore.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All" />
  </ItemGroup>

</Project>
